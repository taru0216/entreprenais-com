---
// src/layouts/BaseLayout.astro — gurinbizu-game
// Generated by app-bootstrap (astro-static template, #5321)
// テーマ変数注入の基盤レイアウト (#5318 で拡張予定)

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "グリンビーズゲーム",
  description = "FC のお子さんが考案した手書きルール『グリンビーズゲーム（女）』を Web ゲームとして実装。グリンビーズを選んでお店を開き、注文を受けて届けてゴールするままごとゲーム。",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      /* CSS カスタムプロパティ — テーマ変数 (#5318 で themes/ に分離予定) */
      :root {
        --color-primary: #111;
        --color-bg: #fff;
        --color-text: #333;
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --max-width: 720px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        max-width: var(--max-width);
        margin: 4rem auto;
        padding: 0 1rem;
        line-height: 1.6;
      }

      h1 {
        color: var(--color-primary);
      }

      code {
        background: #f4f4f4;
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
        font-size: 0.9em;
      }

      a {
        color: var(--color-primary);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
