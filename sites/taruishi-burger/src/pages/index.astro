---
// src/pages/index.astro — taruishi-burger-astro
// 樽石バーガー キッチンカー ホームページ
// Astro static site (astro-static テンプレート #5321)
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title="キッチンカー"
  description="Weber グリルが焼く、本格スマッシュバーガー。樽石バーガーのキッチンカー。"
>

  <style>
    /* NAV */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(15, 14, 11, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: bold;
      color: var(--color-text);
      letter-spacing: 0.05em;
    }
    .nav-logo span { color: var(--color-accent); }
    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }
    .nav-links a {
      color: var(--color-muted);
      font-size: 0.875rem;
      letter-spacing: 0.04em;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--color-text); }

    /* HERO */
    .hero {
      position: relative;
      min-height: 92vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background-image: url('/images/burger-completed-1.jpg');
      background-size: cover;
      background-position: center;
      filter: brightness(0.35);
      transition: opacity 0.5s;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        var(--color-hero-from) 0%,
        transparent 30%,
        transparent 70%,
        var(--color-hero-to) 100%
      );
    }
    .hero-inner {
      position: relative;
      z-index: 2;
      max-width: 720px;
      padding: 0 24px;
    }
    .hero-badge {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-accent);
      border: 1px solid var(--color-accent);
      border-radius: 99px;
      padding: 5px 16px;
      margin-bottom: 24px;
    }
    .hero-title {
      font-family: var(--font-heading);
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: bold;
      line-height: 1.25;
      letter-spacing: 0.02em;
      margin-bottom: 24px;
    }
    .hero-title .brand {
      display: block;
      color: var(--color-gold);
      font-size: 0.6em;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
    }
    .hero-subtitle {
      font-size: 1.05rem;
      color: rgba(240, 235, 228, 0.78);
      margin-bottom: 40px;
      line-height: 1.8;
    }
    .hero-subtitle em { color: var(--color-gold); font-style: normal; }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent2));
      color: #fff;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.04em;
      padding: 16px 40px;
      border-radius: 99px;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 20px #e85d0440;
    }
    .hero-cta:hover {
      color: #fff;
      transform: translateY(-2px);
      box-shadow: 0 8px 28px #e85d0460;
    }
    .hero-cta svg { width: 14px; height: 14px; }
    .hero-photo-credit {
      position: absolute;
      bottom: 20px;
      right: 24px;
      font-size: 0.65rem;
      color: rgba(240, 235, 228, 0.3);
      letter-spacing: 0.06em;
      z-index: 2;
    }

    /* SECTION COMMON */
    section { padding: 100px 24px; }
    .section-inner {
      max-width: var(--max-w);
      margin: 0 auto;
    }
    .section-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-accent);
      margin-bottom: 12px;
    }
    .section-title {
      font-family: var(--font-heading);
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: bold;
      margin-bottom: 20px;
    }
    .divider {
      width: 48px;
      height: 3px;
      background: linear-gradient(90deg, var(--color-accent), var(--color-gold));
      border-radius: 99px;
      margin-bottom: 24px;
    }
    .section-desc {
      color: rgba(240, 235, 228, 0.7);
      max-width: 600px;
      margin-bottom: 48px;
    }

    /* MENU */
    #menu { background: var(--color-surface); }
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 28px;
    }
    .menu-card {
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: calc(var(--radius) * 1.5);
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .menu-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.4);
    }
    .menu-thumb {
      position: relative;
      height: 220px;
      overflow: hidden;
    }
    .menu-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s;
    }
    .menu-card:hover .menu-thumb img { transform: scale(1.04); }
    .menu-thumb-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 99px;
      background: rgba(240, 235, 228, 0.15);
      color: var(--color-muted);
      border: 1px solid var(--color-border);
      backdrop-filter: blur(8px);
    }
    .menu-thumb-badge.gold {
      background: linear-gradient(135deg, #b8860b, var(--color-gold));
      color: #0f0e0b;
      border: none;
    }
    .menu-body { padding: 24px; }
    .menu-name {
      font-family: var(--font-heading);
      font-size: 1.2rem;
      font-weight: bold;
      margin-bottom: 8px;
      color: var(--color-text);
    }
    .menu-desc {
      font-size: 0.875rem;
      color: var(--color-muted);
      margin-bottom: 16px;
      line-height: 1.6;
    }
    .menu-price-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
    .menu-price {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-gold);
      letter-spacing: -0.01em;
    }
    .menu-price span { font-size: 0.85rem; font-weight: 400; color: var(--color-muted); }
    .menu-tag {
      font-size: 0.7rem;
      color: var(--color-accent);
      border: 1px solid var(--color-accent);
      border-radius: 4px;
      padding: 3px 10px;
      letter-spacing: 0.05em;
    }

    /* GALLERY */
    .gallery-intro {
      display: flex;
      gap: 48px;
      margin-bottom: 48px;
      align-items: flex-start;
    }
    .gallery-intro-text { flex: 1; }
    .gallery-intro-meta { flex-shrink: 0; }
    .gallery-meta-row {
      display: flex;
      gap: 16px;
      font-size: 0.85rem;
      border-bottom: 1px solid var(--color-border);
      padding: 10px 0;
    }
    .gallery-meta-row span { color: var(--color-muted); width: 60px; flex-shrink: 0; }
    .gallery-meta-row strong { color: var(--color-text); }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .gallery-item {
      position: relative;
      height: 200px;
      overflow: hidden;
      border-radius: var(--radius);
      cursor: pointer;
    }
    .gallery-item.featured {
      grid-column: span 2;
      height: 320px;
    }
    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s, filter 0.3s;
    }
    .gallery-item:hover img {
      transform: scale(1.03);
      filter: brightness(1.08);
    }
    .gallery-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 16px 20px;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 100%);
    }
    .gallery-caption-label {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-accent);
      margin-bottom: 4px;
    }
    .gallery-caption-title {
      font-family: var(--font-heading);
      font-size: 0.95rem;
      font-weight: bold;
      color: var(--color-text);
    }
    .gallery-caption-sub {
      font-size: 0.75rem;
      color: rgba(240,235,228,0.6);
      margin-top: 2px;
    }
    .gallery-rank {
      position: absolute;
      top: 14px;
      right: 14px;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 99px;
    }
    .gallery-rank.rank-1 {
      background: linear-gradient(135deg, #b8860b, var(--color-gold));
      color: #0f0e0b;
    }
    .gallery-rank.rank-2 {
      background: rgba(240,235,228,0.15);
      color: var(--color-muted);
      border: 1px solid var(--color-border);
      backdrop-filter: blur(8px);
    }

    /* COMMITMENT */
    .commit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }
    .commit-card {
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: calc(var(--radius) * 1.5);
      padding: 32px;
      transition: border-color 0.2s;
    }
    .commit-card:hover { border-color: var(--color-accent); }
    .commit-icon { font-size: 2rem; margin-bottom: 16px; }
    .commit-title {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      font-weight: bold;
      margin-bottom: 12px;
    }
    .commit-desc {
      font-size: 0.9rem;
      color: var(--color-muted);
      line-height: 1.7;
    }
    .commit-desc strong { color: var(--color-text); }

    /* LOCATION */
    #location { background: var(--color-surface); }
    .location-box {
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: calc(var(--radius) * 2);
      padding: 48px;
      text-align: center;
      max-width: 560px;
      margin: 0 auto;
    }
    .location-icon { font-size: 2.5rem; display: block; margin-bottom: 16px; }
    .location-status {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-accent);
      border: 1px solid var(--color-accent);
      border-radius: 99px;
      display: inline-block;
      padding: 4px 16px;
      margin-bottom: 20px;
    }
    .location-title {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      margin-bottom: 16px;
    }
    .location-desc {
      font-size: 0.9rem;
      color: var(--color-muted);
      line-height: 1.8;
      margin-bottom: 28px;
    }
    .location-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--color-accent);
      color: #fff;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 12px 28px;
      border-radius: 99px;
      transition: background 0.2s, transform 0.2s;
    }
    .location-cta-btn:hover {
      color: #fff;
      background: var(--color-accent2);
      transform: translateY(-2px);
    }

    /* CONTACT */
    #contact { background: var(--color-bg); }
    .contact-box {
      max-width: 560px;
      margin: 0 auto;
    }
    .contact-note {
      font-size: 0.9rem;
      color: var(--color-muted);
      margin-bottom: 32px;
      line-height: 1.7;
    }
    .form-group { margin-bottom: 20px; }
    .form-label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-muted);
      margin-bottom: 8px;
      letter-spacing: 0.04em;
    }
    .form-input, .form-textarea {
      width: 100%;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 12px 16px;
      color: var(--color-text);
      font-family: var(--font-body);
      font-size: 0.95rem;
      transition: border-color 0.2s;
    }
    .form-input:focus, .form-textarea:focus {
      outline: none;
      border-color: var(--color-accent);
    }
    .form-textarea { min-height: 120px; resize: vertical; }
    .form-submit {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent2));
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      padding: 14px 36px;
      border-radius: 99px;
      border: none;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 20px #e85d0430;
    }
    .form-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px #e85d0450;
    }
    .form-notice {
      font-size: 0.75rem;
      color: var(--color-muted);
      margin-top: 14px;
    }

    /* FOOTER */
    footer {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      padding: 40px 24px;
      text-align: center;
    }
    .footer-logo {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      color: var(--color-text);
      margin-bottom: 8px;
    }
    .footer-logo span { color: var(--color-accent); }
    .footer-tagline {
      font-size: 0.8rem;
      color: var(--color-muted);
      margin-bottom: 20px;
      letter-spacing: 0.04em;
    }
    .footer-copy {
      font-size: 0.75rem;
      color: var(--color-border);
    }

    /* LIGHTBOX */
    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0,0,0,0.92);
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .lightbox.active { display: flex; }
    .lightbox-inner {
      position: relative;
      max-width: 900px;
      max-height: 90vh;
      width: 100%;
    }
    .lightbox img {
      width: 100%;
      height: auto;
      max-height: 85vh;
      object-fit: contain;
      border-radius: var(--radius);
    }
    .lightbox-close {
      position: absolute;
      top: -44px;
      right: 0;
      background: none;
      border: none;
      color: var(--color-muted);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 8px;
      line-height: 1;
    }
    .lightbox-close:hover { color: var(--color-text); }
    .lightbox-caption {
      text-align: center;
      margin-top: 12px;
      font-size: 0.85rem;
      color: var(--color-muted);
    }

    /* RESPONSIVE */
    @media (max-width: 640px) {
      section { padding: 72px 20px; }
      .location-box { padding: 32px 24px; }
      .nav-links { display: none; }
      .gallery-grid { grid-template-columns: 1fr; }
      .gallery-item.featured { height: 260px; }
      .gallery-intro { flex-direction: column; }
    }
  </style>

  <!-- NAV -->
  <nav>
    <div class="nav-inner">
      <div class="nav-logo">樽石<span>バーガー</span></div>
      <ul class="nav-links">
        <li><a href="#menu">メニュー</a></li>
        <li><a href="#gallery">実験記録</a></li>
        <li><a href="#commitment">こだわり</a></li>
        <li><a href="#location">出店情報</a></li>
        <li><a href="#contact">お問い合わせ</a></li>
      </ul>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero" id="home">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <div class="hero-badge">Kitchen Car — Taruishi Burger</div>
      <h1 class="hero-title">
        <span class="brand">樽石バーガー</span>
        Weber グリルが焼く、<br>本格スマッシュバーガー
      </h1>
      <p class="hero-subtitle">
        <em>アンガスビーフパティ</em> × <em>Weber PULSE</em> の精密温度管理。<br>
        どこまでも肉に向き合う、キッチンカーの一杯。
      </p>
      <a href="#menu" class="hero-cta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><path d="M9 5l7 7-7 7"/></svg>
        メニューを見る
      </a>
    </div>
    <div class="hero-photo-credit">Photo: 2026-05-30 実験記録</div>
  </section>

  <!-- MENU -->
  <section id="menu">
    <div class="section-inner">
      <p class="section-label">Menu</p>
      <h2 class="section-title">こだわりのバーガー</h2>
      <div class="divider"></div>
      <p class="section-desc">全パティは Weber PULSE の精密温度管理で焼き上げます。</p>

      <div class="menu-grid">
        <div class="menu-card">
          <div class="menu-thumb">
            <img src={`${BASE}/images/burger-completed-1.jpg`} alt="アンガスビーフチーズバーガー" loading="eager" />
            <span class="menu-thumb-badge gold">No.1 Signature</span>
          </div>
          <div class="menu-body">
            <div class="menu-name">アンガスビーフチーズバーガー</div>
            <p class="menu-desc">
              イオン直仕入れのアンガスビーフパティを Weber PULSE でスマッシュ焼き。
              チェダーチーズを重ね、特製ソースと共に。4種比較でダントツ1位を獲得した自信作。
            </p>
            <div class="menu-price-row">
              <div class="menu-price">¥1,200 <span>(税込)</span></div>
              <div class="menu-tag">人気 No.1</div>
            </div>
          </div>
        </div>

        <div class="menu-card">
          <div class="menu-thumb">
            <img src={`${BASE}/images/burger-completed-2.jpg`} alt="スタンダードチーズバーガー" loading="eager" />
            <span class="menu-thumb-badge">Standard</span>
          </div>
          <div class="menu-body">
            <div class="menu-name">スタンダードチーズバーガー</div>
            <p class="menu-desc">
              NittoBest パティをスマッシュ焼き。コスパ重視ながら肉の旨みを最大限に引き出した、
              日常使いの一杯。
            </p>
            <div class="menu-price-row">
              <div class="menu-price">¥900 <span>(税込)</span></div>
              <div class="menu-tag">毎日食べたい</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery">
    <div class="section-inner">
      <p class="section-label">Research Log — 2026.05.30</p>
      <h2 class="section-title">4種パティ実験記録</h2>
      <div class="divider"></div>

      <div class="gallery-intro">
        <div class="gallery-intro-text">
          <p class="section-desc" style="margin-bottom:0;">
            Weber PULSE × スマッシュバーガー技法で4種のパティを徹底比較。
            火入れ・食感・旨み・コストパフォーマンスを実食評価し、
            アンガスビーフがダントツ1位の結果に。この実験がメニュー開発の原点です。
          </p>
        </div>
        <div class="gallery-intro-meta">
          <div class="gallery-meta-row"><span>実験日</span><strong>2026年5月30日</strong></div>
          <div class="gallery-meta-row"><span>グリル</span><strong>Weber PULSE 2000</strong></div>
          <div class="gallery-meta-row"><span>技法</span><strong>スマッシュバーガー</strong></div>
          <div class="gallery-meta-row"><span>比較数</span><strong>4種のパティ</strong></div>
          <div class="gallery-meta-row"><span>結果</span><strong style="color:var(--color-gold);">アンガスビーフ 1位</strong></div>
        </div>
      </div>

      <div class="gallery-grid">
        <div class="gallery-item featured" onclick="openLightbox(this)">
          <img
            src={`${BASE}/images/burger-completed-1.jpg`}
            alt="D: アンガスビーフチーズバーガー完成 — 実験1位"
            loading="eager"
            data-caption="D: アンガスビーフチーズバーガー — 実験ダントツ1位 (2026.05.30)"
          />
          <span class="gallery-rank rank-1">1位 — ダントツ</span>
          <div class="gallery-caption">
            <div class="gallery-caption-label">Patty D — Angus Beef</div>
            <div class="gallery-caption-title">アンガスビーフチーズバーガー</div>
            <div class="gallery-caption-sub">イオン直仕入れ — 火入れ・食感・旨みすべてで圧勝</div>
          </div>
        </div>

        <div class="gallery-item" onclick="openLightbox(this)">
          <img
            src={`${BASE}/images/burger-completed-2.jpg`}
            alt="A: NittoBest チーズバーガー完成"
            loading="eager"
            data-caption="A: NittoBest チーズバーガー (2026.05.30)"
          />
