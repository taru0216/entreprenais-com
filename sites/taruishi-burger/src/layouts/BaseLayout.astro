---
// src/layouts/BaseLayout.astro — taruishi-burger-astro
// Generated by app-bootstrap (astro-static template, #5321)
// テーマ変数注入の基盤レイアウト

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "樽石バーガー",
  description = "Weber グリルが焼く、本格スマッシュバーガー。キッチンカー",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | 樽石バーガー</title>
    <style>
      /* CSS カスタムプロパティ — 樽石バーガー テーマ */
      :root {
        --color-bg:        #0f0e0b;
        --color-surface:   #1a1814;
        --color-card:      #231f1a;
        --color-border:    #2e2820;
        --color-accent:    #e85d04;
        --color-accent2:   #f48c06;
        --color-gold:      #faa307;
        --color-text:      #f0ebe4;
        --color-muted:     #a09080;
        --color-hero-from: #1a0a00;
        --color-hero-to:   #0f0e0b;
        --font-heading:    'Georgia', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
        --font-body:       'Helvetica Neue', 'Hiragino Sans', 'Meiryo', sans-serif;
        --radius:          8px;
        --max-w:           1100px;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      body {
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--color-accent); text-decoration: none; }
      a:hover { color: var(--color-gold); }
      img { max-width: 100%; height: auto; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
