---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: 'lp' | 'blog' | 'story';
  lang?: string;
}

const {
  title,
  description = '希少部位・国産牛の韓国焼肉。池袋駅徒歩2分。食べ放題55品・個室あり。',
  activePage = 'lp',
  lang = 'ja',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="https://banwaen-ikebukuro.foodre.jp/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <Header activePage={activePage} lang={lang} />
  <slot />
  <Footer lang={lang} />
</body>
</html>
