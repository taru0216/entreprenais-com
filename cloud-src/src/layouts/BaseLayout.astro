---
// src/layouts/BaseLayout.astro — entreprenais-cloud-astro
// entreprenais.com/cloud 「グリーンAIクラウド」LP 基盤レイアウト（#303）
// 将来のLP差し替え時はこのファイル + src/pages/index.astro のみの改修で完結する設計

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "グリーンAIクラウド",
  description = "「超高速、超省電力」グリーンAIクラウド誕生。0.4msの超高速応答とコスト効率、電源構成の透明性を両立する、自社グリーンデータセンター上のエージェント実行基盤。",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | EntreprenAIs</title>
    <meta property="og:title" content={`${title} | EntreprenAIs`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      /* #312: entreprenais.com トップページ（root index.html / style.css）の
         ブランドトーンに準拠。オフホワイト基調＋インディゴアクセントの
         トップページ配色パターンを踏襲しつつ、「グリーンAIクラウド」の
         商品識別性のためグリーンをセカンドアクセントとして残す。 */
      :root {
        --color-bg:        #f7f6f1;
        --color-surface:   #ffffff;
        --color-card:      #f7f6f1;
        --color-border:    #d5d2c6;
        --color-accent:    #2a2d7c;
        --color-accent2:   #4a4ee0;
        --color-green:     #1f9d55;
        --color-green2:    #16a34a;
        --color-gold:      #0f3d24;
        --color-text:      #0d0f12;
        --color-text-soft: #1a1d22;
        --color-muted:     #6b6b6b;
        --color-hero-from: #f7f6f1;
        --color-hero-to:   #f7f6f1;
        --font-heading:    'Noto Sans JP', 'Inter', system-ui, sans-serif;
        --font-body:       'Noto Sans JP', 'Inter', system-ui, sans-serif;
        --radius:          10px;
        --max-w:           1100px;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: var(--color-accent); text-decoration: none; }
      a:hover { color: var(--color-accent2); }
      img { max-width: 100%; height: auto; }

      /* #314: entreprenais.com トップページの reveal（スクロール連動フェードイン）
         パターンを踏襲。data-reveal 属性を持つ要素を IntersectionObserver で監視する。 */
      .reveal {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      (function () {
        var reveals = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) {
          reveals.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var delay = parseInt(el.getAttribute("data-delay") || "0", 10);
            setTimeout(function () {
              el.classList.add("is-visible");
            }, isNaN(delay) ? 0 : delay);
            io.unobserve(el);
          });
        }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
        reveals.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
