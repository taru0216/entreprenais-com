---
// src/layouts/BaseLayout.astro — entreprenais-cloud-astro
// entreprenais.com/cloud 「グリーンAIクラウド」LP 基盤レイアウト（#303）
// 将来のLP差し替え時はこのファイル + src/pages/index.astro のみの改修で完結する設計

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "グリーンAIクラウド",
  description = "「超高速、超省電力」グリーンAIクラウド誕生。コスト効率・応答速度を求めるIT意思決定層、電源構成の透明性を求めるESG/CSR推進企業へ。大脳（ローカルLLM）×反射（CPU上の自社開発技術）のハイブリッドアーキテクチャによる、超省電力・超高速のエージェント実行基盤。",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | EntreprenAIs</title>
    <meta property="og:title" content={`${title} | EntreprenAIs`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <style>
      /* #310: FCフィードバックにより黒背景から明るいグリーン系トーンへ変更。
         グリーン=環境配慮の清潔感、AI=先進性を意識した配色。 */
      :root {
        --color-bg:        #f4f9f3;
        --color-surface:   #ffffff;
        --color-card:      #eaf5ea;
        --color-border:    #cfe6cf;
        --color-accent:    #1f9d55;
        --color-accent2:   #16a34a;
        --color-gold:      #0f3d24;
        --color-text:      #12261a;
        --color-muted:     #4b6357;
        --color-hero-from: #eafaf0;
        --color-hero-to:   #f4f9f3;
        --font-heading:    'Hiragino Sans', 'Segoe UI', sans-serif;
        --font-body:       'Hiragino Sans', 'Segoe UI', sans-serif;
        --radius:          10px;
        --max-w:           1100px;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--color-accent); text-decoration: none; }
      a:hover { color: var(--color-accent2); }
      img { max-width: 100%; height: auto; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
