      { q: '従来のクラウドLLM運用と何が違いますか？', own: '大規模GPUデータセンターの電力とネットワーク往復に依存しません。コスト・環境負荷・応答速度の制約を同時に外せます。', cloud: '一般的なクラウドLLM運用では、推論をリモートのGPUクラスタで実行するため、ネットワーク往復と待ち行列の影響を受けることが知られていますが、構成によって差があります。', cloudMs: 12900 },
      { q: '「大脳AI」は何をしていますか？', own: '複雑な判断と生成だけを担当します。自社データセンター内のローカルLLMなので、電力起源も自社で完結します。', cloud: 'ご質問の「大脳AI」という名称は一般的な技術用語ではないため、正確な定義は提供元の資料をご確認いただく必要がありますが、階層的な推論アーキテクチャを指す可能性があります。', cloudMs: 16400 },
      { q: '設計図を実行体に変える技術とは？', own: 'コンパイル技術です。大脳AIが書いた設計図を、CPUだけで動く実行体と推論が必要な部分に分離します。現時点では人と並走しながら進める半自動の工程で、CPU実行の比率を段階的に高めています。', cloud: 'LLMの出力をコードやワークフローへ変換する手法は複数提案されており、コード生成、プロンプトのキャッシュ、ルールベースへの蒸留などが一般に議論されていますが、実装は事業者ごとに異なります。', cloudMs: 18700 },
      { q: '電力の制約が先だったのですか？', own: 'はい。再エネの出力上限が先にありました。消費電力を極限まで下げる必要から、このハイブリッド構成が生まれました。', cloud: '一般に再生可能エネルギーの出力は変動するため、電力制約を前提とした計算資源の設計が必要になると考えられますが、具体的な設計判断は各事業者の方針に依存します。', cloudMs: 11200 },
      { q: 'ESG報告に使える証跡は出せますか？', own: '電源構成を対外開示し、証跡整備を前提に運用しています。個別契約の粒度はご相談ください。', cloud: '電力証跡の開示範囲については、利用しているクラウド事業者の公開情報に依存するため、詳細な内訳を提示できない場合があります。', cloudMs: 10600 },
      { q: '導入の相談はできますか？', own: 'できます。IT導入のご担当者様、ESG/CSR推進のご担当者様からの導入相談・共同研究を承っています。', cloud: '導入に関するご相談窓口については、提供元の公開情報をご確認いただくのが確実です。一般的には問い合わせフォームまたは営業窓口が案内されています。', cloudMs: 9800 }
    ];

    var CLOCK = function () { return (typeof performance !== 'undefined') ? performance.now() : Date.now(); };

    var root = document.getElementById('live-demo-root');
    if (!root) return;

    var ownBody = document.getElementById('demo-own-body');
    var cloudBody = document.getElementById('demo-cloud-body');
    var ownIdleEl = ownBody.querySelector('[data-own-idle]');
    var cloudIdleEl = cloudBody.querySelector('[data-cloud-idle]');
    var ownTurnLabelEl = document.querySelector('[data-own-turn-label]');
    var cloudTurnLabelEl = document.querySelector('[data-cloud-turn-label]');
    var ownMsBigEl = document.querySelector('[data-own-ms-big]');
    var cloudSecBigEl = document.querySelector('[data-cloud-sec-big]');

    var timers = [];
    var intervals = [];
    var started = false;
    var ownMsTotal = 0;
    var cloudTotalStart = 0;
    var cloudTotalIv = null;
    var stickOwn = true;
    var stickCloud = true;

    function clearAllTimers() {
      timers.forEach(function (t) { clearTimeout(t); });
      intervals.forEach(function (t) { clearInterval(t); });
      timers = [];
      intervals = [];
    }

    function watchScroll(el, key) {
      if (el.dataset.watched) return;
      el.dataset.watched = '1';
      el.addEventListener('scroll', function () {
        var atBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 48;
        if (key === 'own') stickOwn = atBottom; else stickCloud = atBottom;
      }, { passive: true });
    }
    watchScroll(ownBody, 'own');
    watchScroll(cloudBody, 'cloud');

    function maybeStick() {
      if (stickOwn) ownBody.scrollTop = ownBody.scrollHeight;
      if (stickCloud) cloudBody.scrollTop = cloudBody.scrollHeight;
    }

    function appendUserBubble(body, text) {
      var div = document.createElement('div');
      div.className = 'demo-bubble--user';
      div.textContent = text;
      body.appendChild(div);
    }

    function ownTurn(i) {
      if (i >= SCRIPT.length) return;
      var step = SCRIPT[i];
      appendUserBubble(ownBody, step.q);
      ownTurnLabelEl.textContent = '応答中';
      maybeStick();

      var t1 = setTimeout(function () {
        ownMsTotal = Math.round((ownMsTotal + 0.5) * 10) / 10;
        ownMsBigEl.textContent = ownMsTotal.toFixed(1);

        var wrap = document.createElement('div');
        wrap.className = 'demo-bubble-wrap';
        var bubble = document.createElement('div');
        bubble.className = 'demo-bubble--ai';
        var caret = document.createElement('span');
        caret.className = 'demo-caret';
        bubble.appendChild(caret);
        var meta = document.createElement('span');
        meta.className = 'demo-bubble__meta';
        wrap.appendChild(bubble);
        wrap.appendChild(meta);
        ownBody.appendChild(wrap);
        maybeStick();

        var n = 0;
        var typer = setInterval(function () {
          n += 2;
          var done = n >= step.own.length;
          bubble.textContent = step.own.slice(0, n);
          if (!done) { bubble.appendChild(caret); }
          else { meta.textContent = 'source: cache · 0.5 ms'; }
          maybeStick();
          if (done) {
            clearInterval(typer);
            var idx = intervals.indexOf(typer);
            if (idx >= 0) intervals.splice(idx, 1);
            var t2 = setTimeout(function () {
              var nextI = i + 1;
              if (nextI >= SCRIPT.length) {
                ownTurnLabelEl.textContent = '会話完了';
              } else {
                ownTurn(nextI);
              }
            }, 700);
            timers.push(t2);
          }
        }, 14);
        intervals.push(typer);
      }, 130);
      timers.push(t1);
    }

    function cloudTurn(i) {
      if (i >= SCRIPT.length) {
        cloudTurnLabelEl.textContent = '会話完了';
        if (cloudTotalIv) { clearInterval(cloudTotalIv); cloudTotalIv = null; }
        var replay = setTimeout(runDemo, 3200);
        timers.push(replay);
        return;
      }
      var step = SCRIPT[i];
      appendUserBubble(cloudBody, step.q);
      cloudTurnLabelEl.textContent = '生成中';
      maybeStick();

      var waiting = document.createElement('div');
      waiting.className = 'demo-waiting';
      waiting.innerHTML = '<span class="demo-spinner"></span><span class="txt">generating… <span data-cur-sec>0.0</span> s</span>';
      cloudBody.appendChild(waiting);
      maybeStick();
      var curSecEl = waiting.querySelector('[data-cur-sec]');

      var t0 = CLOCK();
      var iv2 = setInterval(function () {
        curSecEl.textContent = ((CLOCK() - t0) / 1000).toFixed(1);
      }, 100);
      intervals.push(iv2);

      var c1 = setTimeout(function () {
        clearInterval(iv2);
        var idx = intervals.indexOf(iv2);
        if (idx >= 0) intervals.splice(idx, 1);
        if (waiting.parentNode) waiting.parentNode.removeChild(waiting);

        var wrap = document.createElement('div');
        wrap.className = 'demo-bubble-wrap';
        var bubble = document.createElement('div');
        bubble.className = 'demo-bubble--ai';
        bubble.textContent = step.cloud;
        var meta = document.createElement('span');
        meta.className = 'demo-bubble__meta';
        meta.textContent = 'source: cloud-inference · ' + (step.cloudMs / 1000).toFixed(1) + ' s';
        wrap.appendChild(bubble);
        wrap.appendChild(meta);
        cloudBody.appendChild(wrap);
        maybeStick();

        var c2 = setTimeout(function () { cloudTurn(i + 1); }, 700);
        timers.push(c2);
      }, step.cloudMs);
      timers.push(c1);
    }

    function runDemo() {
      clearAllTimers();
      stickOwn = true;
      stickCloud = true;
      started = true;
      ownMsTotal = 0;
      ownBody.innerHTML = '';
      cloudBody.innerHTML = '';
      ownMsBigEl.textContent = '0.5';
      cloudSecBigEl.textContent = '9.5';
      ownTurnLabelEl.textContent = '応答中';
      cloudTurnLabelEl.textContent = '生成中';

      var t0 = CLOCK();
      cloudTotalIv = setInterval(function () {
        cloudSecBigEl.textContent = ((CLOCK() - t0) / 1000).toFixed(1);
      }, 100);
      intervals.push(cloudTotalIv);

      ownTurn(0);
      cloudTurn(0);
    }

    function resetDemo() {
      clearAllTimers();
      started = false;
      ownBody.innerHTML = '';
      cloudBody.innerHTML = '';
      ownBody.appendChild(ownIdleEl);
      cloudBody.appendChild(cloudIdleEl);
      ownMsBigEl.textContent = '0.5';
      cloudSecBigEl.textContent = '9.5';
      ownTurnLabelEl.textContent = '自社グリーンDC / 反射経路';
      cloudTurnLabelEl.textContent = '他社DC経由 / 毎回フル生成';
    }

    var demoSection = document.getElementById('demo');
    if (demoSection && typeof IntersectionObserver === 'function') {
      var demoIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            if (!started) runDemo();
          } else if (started) {
            resetDemo();
          }
        });
      }, { threshold: 0.35 });
      demoIo.observe(demoSection);
    } else if (demoSection) {
      runDemo();
    }

    // #358/#360: ヒーロー iPhone フレーム自動再生。FC指摘「勝手に独自のアニメ作らなくて
    // 良い。LIVE DEMOの10ターンのチャットのデモが重要」「それと同じターンを iPhone
    // にも出す」を受け、上記 SCRIPT（LIVE DEMOと同一スコープ内で共有）の own側のみを
    // ownTurn と同一パターンのタイプライター演出で再生する軽量版。cloud側の比較表示は
    // LIVE DEMO専用のまま複製しない。ヒーローセクションが画面に入ったら自動再生を
    // 開始し、画面外に出たらリセットする（LIVE DEMOと同じ IntersectionObserver
    // パターン）。#360: 別 <script> ブロックに分離すると Astro の hoisted バンドラーが
    // 記述順序を保持せず定義前に参照される障害が発生したため、SCRIPT 定義と同一 IIFE内に
    // まとめて実行順序を保証する。
    (function () {
      var msgsEl = document.getElementById('hero-phone-msgs');
      var msValueEl = document.getElementById('hero-phone-ms-value');
    if (!msgsEl || !msValueEl) return;

    var idleHtml = msgsEl.innerHTML;
    var timers = [];
    var intervals = [];
    var started = false;
    var msTotal = 0;

    function clearAllTimers() {
      timers.forEach(function (t) { clearTimeout(t); });
      intervals.forEach(function (t) { clearInterval(t); });
      timers = [];
      intervals = [];
    }

    function appendUserBubble(text) {
      var div = document.createElement('div');
      div.className = 'hero-phone-mock__msg hero-phone-mock__msg--in';
      div.textContent = text;
      msgsEl.appendChild(div);
      msgsEl.scrollTop = msgsEl.scrollHeight;
    }

    function heroPhoneTurn(i) {
      if (i >= SCRIPT.length) {
        var replay = setTimeout(function () { heroPhoneRun(); }, 3200);
        timers.push(replay);
        return;
      }
      var step = SCRIPT[i];
      appendUserBubble(step.q);

      var t1 = setTimeout(function () {
        msTotal = Math.round((msTotal + 0.5) * 10) / 10;
        msValueEl.textContent = msTotal.toFixed(1);

        var bubble = document.createElement('div');
        bubble.className = 'hero-phone-mock__msg hero-phone-mock__msg--out';
        var caret = document.createElement('span');
        caret.className = 'hero-phone-caret';
        bubble.appendChild(caret);
        msgsEl.appendChild(bubble);
        msgsEl.scrollTop = msgsEl.scrollHeight;

        var n = 0;
        var typer = setInterval(function () {
          n += 3;
          var done = n >= step.own.length;
          bubble.textContent = step.own.slice(0, n);
          if (!done) bubble.appendChild(caret);
          msgsEl.scrollTop = msgsEl.scrollHeight;
          if (done) {
            clearInterval(typer);
            var idx = intervals.indexOf(typer);
            if (idx >= 0) intervals.splice(idx, 1);
            var t2 = setTimeout(function () { heroPhoneTurn(i + 1); }, 900);
            timers.push(t2);
          }
        }, 16);
        intervals.push(typer);
      }, 130);
      timers.push(t1);
    }

    function heroPhoneRun() {
      clearAllTimers();
      started = true;
      msTotal = 0;
      msgsEl.innerHTML = '';
      msValueEl.textContent = '0.5';
      heroPhoneTurn(0);
    }

    function heroPhoneReset() {
      clearAllTimers();
      started = false;
      msgsEl.innerHTML = idleHtml;
      msValueEl.textContent = '0.5';
    }

    var heroSection = document.querySelector('.hero');
    if (heroSection && typeof IntersectionObserver === 'function' &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var heroIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            if (!started) heroPhoneRun();
          } else if (started) {
            heroPhoneReset();
          }
        });
      }, { threshold: 0.35 });
      heroIo.observe(heroSection);
    }
    // prefers-reduced-motion: reduce の場合は静的な idle 表示（既存マークアップ）のまま
    })();
  })();
  </script>

</BaseLayout>
