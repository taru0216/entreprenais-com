---
// src/pages/index.astro — entreprenais-cloud-astro
// entreprenais.com/cloud 「グリーンAIクラウド」LP（#303）
// リーンキャンバス出典: taru0216/taruishi-llc#2139
// 将来のLP差し替えを前提とし、コピー内容はこのファイル + BaseLayout.astro のみで完結する
//
// #341: FC承認デザインモックアップ（EntreprenAIs_Green_AI_Cloud）への全面リライト。
// ビジュアルデザイン（配色・タイポグラフィ・レイアウト・余白）はモックアップに完全準拠。
// 機能実装（お問合せAIチャットウィジェット埋め込み・実測ベンチマーク比較ロジック・
// ヒーロー背景写真・reveal/KPIメーターアニメーション）は BaseLayout.astro 側のスクリプトを
// そのまま流用し、クラス名の対応関係のみ維持する。
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>

  <style>
    /* ============ NAV ============ */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(247, 246, 241, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 clamp(16px, 3vw, 40px);
      height: 66px;
      display: flex;
      align-items: center;
      gap: clamp(12px, 2vw, 36px);
    }
    .nav-logo {
      display: flex;
      align-items: baseline;
      gap: 10px;
      font-family: var(--font-heading);
      font-weight: 900;
      font-size: 22px;
      letter-spacing: -0.01em;
      color: var(--color-text);
    }
    .nav-logo span { color: var(--color-accent); }
    .nav-logo .dot {
      width: 5px; height: 5px; border-radius: 999px;
      background: var(--color-accent);
      display: inline-block;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin-left: auto;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-links a {
      flex: none;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-text-soft);
      transition: background 0.2s var(--ease), color 0.2s var(--ease);
    }
    .nav-links a:hover { background: var(--color-accent-tint); color: var(--color-accent2); }
    .nav-cta {
      flex: none;
      margin-left: 12px;
      padding: 11px 22px;
      border-radius: 999px;
      background: var(--color-text);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .nav-cta:hover { color: #fff; background: var(--color-accent2); }

    /* ============ HERO ============ */
    .hero {
      position: relative;
      padding: clamp(108px, 13vw, 150px) clamp(20px, 4vw, 40px) 0;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-glow--a {
      position: absolute;
      top: -220px; right: -160px;
      width: 760px; height: 760px;
      border-radius: 999px;
      background: radial-gradient(circle, var(--color-accent-tint) 0%, rgba(230,229,239,0) 68%);
    }
    .hero-photo-bg {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: auto;
      opacity: 0.5;
    }
    .hero-photo-bg--mobile { display: none; }
    .hero-inner {
      position: relative;
      max-width: var(--max-w);
      margin: 0 auto;
      z-index: 1;
    }
    .hero-eyebrow-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 30px;
    }
    .hero-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-accent2);
    }
    .hero-eyebrow-rule {
      height: 1px;
      flex: 1;
      max-width: 120px;
      background: var(--color-border);
    }
    .hero-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px 6px 12px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--color-text-soft);
    }
    .hero-live-dot {
      width: 6px; height: 6px; border-radius: 999px;
      background: var(--color-green);
      animation: eaiPulse 2.4s ease-in-out infinite;
    }
    @keyframes eaiPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    .hero-flex {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(28px, 5vw, 64px);
      align-items: flex-end;
    }
    .hero-col-text { flex: 1 1 440px; min-width: 0; }
    .hero h1 {
      margin: 0;
      font-family: var(--font-heading);
      font-size: clamp(34px, 5.2vw, 76px);
      line-height: 1.14;
      font-weight: 900;
      letter-spacing: -0.015em;
    }
    .hero h1 .accent { color: var(--color-accent); }
    .hero-lede {
      margin: 30px 0 0;
      max-width: 52ch;
      font-size: 19px;
      line-height: 1.85;
      color: var(--color-text-soft);
    }
    .hero-lede strong { color: var(--color-text); font-weight: 700; }
    .hero-value-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 30px;
    }
    .value-tag {
      padding: 8px 16px;
      border-radius: 999px;
      background: var(--color-accent-tint);
      color: var(--color-accent2);
      font-size: 13px;
      font-weight: 700;
    }
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 38px;
    }
    .btn {
      display: inline-block;
      border-radius: 999px;
      font-weight: 700;
      text-align: center;
      transition: transform 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
    }
    .btn-primary {
      padding: 16px 30px;
      background: var(--color-text);
      color: #fff;
      font-size: 15px;
      letter-spacing: 0.02em;
    }
    .btn-primary:hover { background: var(--color-accent2); color: #fff; transform: translateY(-2px); }
    .btn-secondary {
      padding: 14px 28px;
      border: 2px solid var(--color-text);
      color: var(--color-text);
      font-size: 15px;
    }
    .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); transform: translateY(-2px); }

    /* ヒーロー右側の巨大メトリック */
    .hero-col-metric {
      flex: 1 1 300px;
      text-align: right;
      padding-bottom: 6px;
    }
    .hero-metric-inner {
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 8px;
    }
    .hero-metric__value {
      font-family: var(--font-heading);
      font-size: clamp(108px, 16vw, 230px);
      line-height: 0.82;
      font-weight: 900;
      letter-spacing: -0.055em;
      color: var(--color-accent);
      animation: heroMetricPulse 2.6s ease-in-out infinite;
    }
    @keyframes heroMetricPulse {
      0%, 100% { opacity: 1; text-shadow: 0 0 0 rgba(74, 74, 226, 0); }
      50%      { opacity: 0.88; text-shadow: 0 0 32px rgba(74, 74, 226, 0.30); }
    }
    .hero-metric__unit {
      font-size: clamp(28px, 4vw, 56px);
      line-height: 1;
      font-weight: 900;
      color: var(--color-text);
      margin-top: 16px;
    }
    .hero-metric__note {
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--color-border);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.9;
      letter-spacing: 0.03em;
      color: var(--color-muted);
      text-align: right;
      cursor: help;
    }

    /* KPIグリッド（3カラム） */
    .hero-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(228px, 1fr));
      gap: 1px;
      margin-top: clamp(48px, 7vw, 80px);
      background: var(--color-border2);
      border: 1px solid var(--color-border2);
      border-radius: 20px;
      overflow: hidden;
    }
    .hero-kpi-cell {
      background: #fff;
      padding: 28px 30px;
    }
    .hero-kpi-cell__label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .hero-kpi-cell__value {
      margin-top: 12px;
      font-size: 34px;
      font-weight: 900;
      letter-spacing: -0.01em;
    }
    .hero-kpi-cell__value.is-accent { color: var(--color-accent); }
    .hero-kpi-cell__value .unit { font-size: 17px; font-weight: 700; margin-left: 3px; }
    .hero-kpi-cell__desc {
      margin-top: 6px;
      font-size: 13px;
      color: var(--color-text-soft);
    }
    .hero-chat-open {
      margin: 14px 0 0;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--color-muted);
      background: none;
      border: none;
      cursor: pointer;
      font-family: inherit;
      padding: 0;
    }
    .hero-chat-open:hover { color: var(--color-accent2); }

    .hero-footnote {
      margin: 12px 0 0;
      max-width: 88ch;
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--color-muted);
    }

    /* ============ SECTION common ============ */
    .section-light {
      padding: clamp(72px, 10vw, 110px) clamp(20px, 4vw, 40px);
      scroll-margin-top: 66px;
    }
    .section-dark {
      padding: clamp(72px, 10vw, 104px) clamp(20px, 4vw, 40px) clamp(72px, 10vw, 110px);
      background: var(--color-dark-bg);
      scroll-margin-top: 66px;
    }
    .section-inner { max-width: var(--max-w); margin: 0 auto; }
    .eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .eyebrow.on-dark { color: var(--color-accent-light); }
    h2.headline {
      margin: 18px 0 0;
      font-size: clamp(27px, 3.6vw, 46px);
      line-height: 1.3;
      font-weight: 900;
      letter-spacing: -0.005em;
    }
    h2.headline.narrow { max-width: 30ch; }
    h2.headline .accent { color: var(--color-accent); }
    .section-lede {
      margin: 20px 0 0;
      max-width: 60ch;
      font-size: 17px;
      line-height: 1.9;
      color: var(--color-text-soft);
    }
    .section-lede.on-dark { color: var(--color-dark-text-soft); }
    .note {
      margin-top: 22px;
      padding-top: 24px;
      border-top: 1px solid var(--color-border);
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--color-muted);
      max-width: 96ch;
    }
    .note.on-dark { border-top-color: var(--color-dark-border); color: var(--color-dark-muted); }
    .note strong { color: var(--color-text-soft); }
    .note.on-dark strong { color: var(--color-dark-text-soft); }

    /* PROBLEM（3カード） */
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(268px, 1fr));
      gap: 20px;
      margin-top: 56px;
    }
    .problem-card {
      padding: 34px;
      background: #fff;
      border: 1px solid var(--color-border2);
      border-radius: 22px;
    }
    .problem-card__label {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--color-accent2);
    }
    .problem-card h3 {
      margin: 16px 0 0;
      font-size: 23px;
      font-weight: 700;
      line-height: 1.5;
    }
    .problem-card p {
      margin: 14px 0 0;
      font-size: 14.5px;
      line-height: 1.9;
      color: var(--color-text-soft);
    }

    /* SPEED COMPARISON（ダーク・チャットUIカード2枚） */
    .compare-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 24px;
      margin-top: 44px;
    }
    .compare-card {
      border: 1px solid var(--color-dark-border);
      border-radius: 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .compare-card.is-ours { background: var(--color-dark-navy); }
    .compare-card.is-cloud { background: var(--color-dark-surface); }
    .compare-card__head {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px 22px;
      border-bottom: 1px solid var(--color-dark-border2);
      background: var(--color-dark-card);
    }
    .compare-card.is-cloud .compare-card__head {
      border-bottom-color: var(--color-dark-border);
      background: var(--color-dark-slate);
    }
    .compare-card__dot { width: 8px; height: 8px; border-radius: 999px; }
    .compare-card.is-ours .compare-card__dot { background: var(--color-green); }
    .compare-card.is-cloud .compare-card__dot { background: var(--color-orange); }
    .compare-card__title { font-size: 13px; font-weight: 700; color: var(--color-dark-text); }
    .compare-card__badge {
      padding: 3px 9px;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 9.5px;
      letter-spacing: 0.06em;
    }
    .compare-card.is-ours .compare-card__badge { border: 1px solid var(--color-green); color: var(--color-green); }
    .compare-card.is-cloud .compare-card__badge { border: 1px solid var(--color-dark-border3); color: var(--color-dark-muted2); }
    .compare-card__ms {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: 10.5px;
    }
    .compare-card.is-ours .compare-card__ms { color: var(--color-green); }
    .compare-card.is-cloud .compare-card__ms { color: var(--color-orange); }
    .compare-card__body {
      flex: none;
      height: clamp(260px, 38vh, 340px);
      overflow-y: auto;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .compare-bubble--user {
      align-self: flex-end;
      max-width: 82%;
      padding: 13px 18px;
      border-radius: 16px 16px 4px 16px;
      color: var(--color-dark-text);
      font-size: 14.5px;
      line-height: 1.7;
    }
    .compare-card.is-ours .compare-bubble--user { background: var(--color-dark-border2); }
    .compare-card.is-cloud .compare-bubble--user { background: var(--color-dark-border); }
    .compare-bubble--ai {
      max-width: 90%;
      padding: 15px 19px;
      border-radius: 16px 16px 16px 4px;
      font-size: 14.5px;
      line-height: 1.8;
    }
    .compare-card.is-ours .compare-bubble--ai { background: var(--color-dark-navy-border); color: var(--color-dark-text); }
    .compare-card.is-cloud .compare-bubble--ai { background: var(--color-dark-slate); color: var(--color-dark-text-soft); }
    .compare-card__footer {
      padding: 20px 24px;
      border-top: 1px solid var(--color-dark-border2);
      background: var(--color-dark-card);
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .compare-card.is-cloud .compare-card__footer {
      border-top-color: var(--color-dark-border);
      background: var(--color-dark-slate);
    }
    .compare-card__footer-value {
      font-size: clamp(38px, 4vw, 52px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .compare-card.is-ours .compare-card__footer-value { color: var(--color-accent-light); }
    .compare-card.is-cloud .compare-card__footer-value { color: var(--color-dark-muted2); }
    .compare-card__footer-unit { font-size: 18px; font-weight: 900; color: var(--color-dark-text); }
    .compare-card__footer-note {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-dark-muted);
      text-align: right;
    }
    .compare-ratio {
      margin-top: 18px;
      padding-top: 22px;
      border-top: 1px solid var(--color-dark-border);
    }
    .compare-ratio__badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
      color: var(--color-dark-text-soft);
    }
    .compare-ratio__badge strong { color: var(--color-green); font-family: var(--font-mono); }

    /* ARCHITECTURE（ダーク・3要素 + sticky KPIサイドバー） */
    .arch-flex {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(32px, 5vw, 70px);
      align-items: flex-start;
    }
    .arch-col-main { flex: 1 1 520px; min-width: 0; }
    .arch-sub {
      margin-top: 14px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      color: var(--color-accent-light);
    }
    .arch-card-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 44px;
    }
    .arch-card {
      display: flex;
      gap: 20px;
      padding: 30px;
      background: var(--color-dark-surface);
      border: 1px solid var(--color-dark-border);
      border-radius: 20px;
    }
    .arch-card.is-highlight {
      background: var(--color-dark-navy);
      border-color: var(--color-dark-navy-border);
    }
    .arch-card__icon {
      flex: none;
      width: 52px; height: 52px;
      border-radius: 14px;
      background: rgba(123,123,240,0.14);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono);
      font-size: 13px; font-weight: 700;
      color: var(--color-accent-light);
    }
    .arch-card.is-highlight .arch-card__icon { background: rgba(71,199,117,0.14); color: var(--color-green); }
    .arch-card h3 { margin: 0; font-size: 21px; font-weight: 700; color: var(--color-dark-text); }
    .arch-card p { margin: 12px 0 0; font-size: 14.5px; line-height: 1.9; color: var(--color-dark-text-soft); }
    .arch-connector {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 6px;
      color: var(--color-dark-border3);
      font-size: 18px;
    }
    .arch-connector-line { height: 1px; flex: 1; background: var(--color-dark-border); }
    .arch-connector-label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.16em; color: var(--color-accent-light); }

    .arch-sidebar {
      flex: 1 1 320px;
      max-width: 460px;
      position: sticky;
      top: 110px;
      padding: clamp(28px, 3vw, 44px);
      background: var(--color-dark-surface);
      border: 1px solid var(--color-dark-border);
      border-radius: 24px;
    }
    .arch-sidebar__label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--color-dark-muted);
    }
    .arch-sidebar__metric {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-top: 20px;
    }
    .arch-sidebar__value {
      font-size: clamp(78px, 9vw, 110px);
      line-height: 0.86;
      font-weight: 900;
      letter-spacing: -0.05em;
      color: var(--color-accent-light);
    }
    .arch-sidebar__unit { font-size: 30px; font-weight: 900; color: var(--color-dark-text); margin-top: 8px; }
    .arch-sidebar__desc { margin: 22px 0 0; font-size: 13.5px; line-height: 1.9; color: var(--color-dark-text-soft); }
    .arch-sidebar__list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 26px;
      padding-top: 24px;
      border-top: 1px solid var(--color-dark-border);
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--color-dark-muted);
    }
    .arch-sidebar__row { display: flex; justify-content: space-between; }
    .arch-sidebar__row .v { color: var(--color-dark-text); }
    .arch-sidebar__row .v.is-green { color: var(--color-green); }
    .arch-sidebar__cta { margin-top: 24px; }
    .arch-sidebar__cta-note { font-size: 12px; color: var(--color-dark-muted); }

    /* GREEN（3カード） */
    .green-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(288px, 1fr));
      gap: 20px;
      margin-top: 52px;
    }
    .green-card {
      padding: 34px;
      background: #fff;
      border: 1px solid var(--color-border2);
      border-radius: 22px;
    }
    .green-card__icon {
      width: 44px; height: 44px;
      border-radius: 12px;
      background: var(--color-accent-tint);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono);
      font-size: 11px; font-weight: 700;
      color: var(--color-accent2);
    }
    .green-card h3 { margin: 18px 0 0; font-size: 20px; font-weight: 700; }
    .green-card p { margin: 12px 0 0; font-size: 14.5px; line-height: 1.9; color: var(--color-text-soft); }

    /* FLOW（「制約が両立を生んだ」まとめボックス） */
    .flow-box {
      margin-top: clamp(56px, 8vw, 86px);
      padding: clamp(28px, 4vw, 60px);
      background: var(--color-bg);
