---
// src/pages/index.astro — entreprenais-cloud-astro
// entreprenais.com/cloud 「グリーンAIクラウド」LP（#303）
// リーンキャンバス出典: taru0216/taruishi-llc#2139
// 将来のLP差し替えを前提とし、コピー内容はこのファイル + BaseLayout.astro のみで完結する
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>

  <style>
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(247, 246, 241, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 24px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      font-weight: bold;
      color: var(--color-text);
      letter-spacing: 0.02em;
    }
    .nav-logo span { color: var(--color-accent); }
    .nav-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }
    .nav-links a {
      color: var(--color-muted);
      font-size: 0.85rem;
      letter-spacing: 0.02em;
      transition: color 0.2s var(--ease);
    }
    .nav-links a:hover { color: var(--color-text); }

    /* HERO（#312: 0.4ms を大型フォント+アニメーションで主役にする構成に刷新。
       トップページ index.html の hero__grid / hero__glow / reveal パターンを踏襲） */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 8rem 24px 4rem;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(var(--color-border) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
      background-size: 56px 56px;
      background-position: -1px -1px;
      opacity: 0.45;
      mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    }
    .hero-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.5;
    }
    .hero-glow--a {
      width: 480px; height: 480px; top: -120px; left: -160px;
      background: radial-gradient(circle, rgba(31, 157, 85, 0.30), transparent 70%);
    }
    .hero-glow--b {
      width: 380px; height: 380px; bottom: -120px; right: -120px;
      background: radial-gradient(circle, rgba(74, 78, 224, 0.22), transparent 70%);
    }
    .hero-content {
      position: relative;
      z-index: 1;
      max-width: var(--max-w);
      margin: 0 auto;
      width: 100%;
    }
    /* #322: Hero を2カラム化し、右側にチャットプレビュー（実物ウィジェットへの
       導線）を配置。FC依頼「ホームページの右側に超高速チャット」に対応。
       モバイルは下記メディアクエリで1カラムに戻し、chat-preview は背景装飾
       （低コントラスト・pointer-events:none）として組み込む（msg344「背景の
       ような感じが良さそう？スマホでも見えるように」を反映）。 */
    /* #387: factory.ai のレイアウト（見出し・サブコピー・CTAを上部、ビジュアル
       要素はその下）を参考に、横並び2カラムから縦積み（テキスト→ビジュアル）に変更 */
    .hero-grid-layout {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
    .hero-col-text {
      max-width: 46em;
    }
    .hero-visual-row {
      display: grid;
      grid-template-columns: minmax(280px, 1fr) minmax(280px, 1fr);
      gap: 1.5rem;
      align-items: stretch;
    }
    .chat-preview {
      position: relative;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: calc(var(--radius) + 6px);
      padding: 1.25rem;
      box-shadow: 0 24px 48px -24px rgba(13, 15, 18, 0.18);
    }
    .chat-preview__header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-bottom: 0.75rem;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.78rem;
      color: var(--color-muted);
    }
    .chat-preview__dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--color-green);
      animation: chatDotPulse 1.8s ease-in-out infinite;
    }
    @keyframes chatDotPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .chat-preview__bubble {
      border-radius: 12px;
      padding: 0.65rem 0.9rem;
      font-size: 0.85rem;
      line-height: 1.6;
      margin-bottom: 0.6rem;
      max-width: 88%;
    }
    .chat-preview__bubble--user {
      background: var(--color-card);
      color: var(--color-text-soft);
      margin-left: auto;
    }
    .chat-preview__bubble--ai {
      background: rgba(31, 157, 85, 0.08);
      color: var(--color-text);
    }
    .chat-preview__debug {
      font-size: 0.68rem;
      color: var(--color-green);
      opacity: 0.85;
      margin: -0.3rem 0 0.6rem 0.2rem;
    }
    .chat-preview__cta {
      display: block;
      width: 100%;
      text-align: center;
      margin-top: 0.5rem;
      padding: 10px;
      border-radius: var(--radius);
      background: var(--color-accent);
      color: #ffffff;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: background 0.25s var(--ease), transform 0.25s var(--ease);
    }
    .chat-preview__cta:hover {
      background: var(--color-accent2);
      transform: translateY(-2px);
    }
    .chat-preview__note {
      font-size: 0.68rem;
      color: var(--color-muted);
      opacity: 0.75;
      text-align: center;
      margin-top: 0.5rem;
    }

    /* #390/#391: factory.ai のKPIカード（LIVEバッジ＋スパークライン）を参考に、
       「科学的・データドリブン」な信頼感を演出するメーター/グラフカード。
       0.4ms（速度）・超省電力・実質再エネ100%を可視化する。数値はいずれも
       既存の要検証注記の対象と同じ性質のため、断定的な実測値ではなくメーター上の
       目安として表現し、注記も併記する。 */
    .kpi-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: calc(var(--radius) + 6px);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }
    .kpi-card__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      color: var(--color-muted);
      text-transform: uppercase;
    }
    .kpi-live {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--color-green);
      font-weight: 600;
    }
    .kpi-live::before {
      content: '';
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--color-green);
      animation: chatDotPulse 1.8s ease-in-out infinite;
    }
    .kpi-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .kpi-row__label {
      font-size: 0.8rem;
      color: var(--color-text-soft);
    }
    .kpi-row__value {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--color-text);
    }
    /* 速度メーター（0.4ms訴求）: バー内を99%以上満たすことで「速さ」を視覚化 */
    .kpi-meter {
      height: 6px;
      border-radius: 999px;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      overflow: hidden;
    }
    .kpi-meter__fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--color-green), var(--color-green2));
      width: 0%;
      transition: width 1.4s var(--ease);
    }
    .kpi-meter__fill.is-filled { width: var(--fill, 90%); }
    /* スパークライン（簡易 SVG polyline） */
    .kpi-spark {
      width: 100%;
      height: 32px;
      display: block;
    }
    .kpi-spark polyline {
      fill: none;
      stroke: var(--color-green);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .kpi-card__note {
      font-size: 0.64rem;
      color: var(--color-muted);
      opacity: 0.7;
      line-height: 1.5;
    }
    .hero-eyebrow {
      display: inline-block;
      font-size: 0.78rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--color-muted);
      margin-bottom: 2rem;
      padding-left: 1.5rem;
      position: relative;
    }
    .hero-eyebrow::before {
      content: "";
      position: absolute;
      left: 0; top: 50%;
      width: 1rem; height: 1px;
      background: var(--color-muted);
    }

    /* 0.4ms を大型タイポグラフィ＋パルスアニメーションでビジュアルの主役に据える */
    .hero-metric {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.25rem;
    }
    .hero-metric__value {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: clamp(4.5rem, 14vw, 10rem);
      line-height: 0.95;
      letter-spacing: -0.02em;
      color: var(--color-green);
      position: relative;
      animation: heroMetricPulse 2.6s ease-in-out infinite;
    }
    @keyframes heroMetricPulse {
      0%, 100% { opacity: 1; text-shadow: 0 0 0 rgba(31, 157, 85, 0); }
      50%      { opacity: 0.88; text-shadow: 0 0 28px rgba(31, 157, 85, 0.35); }
    }
    .hero-metric__label {
      font-size: clamp(0.9rem, 1.6vw, 1.15rem);
      color: var(--color-muted);
      line-height: 1.6;
      max-width: 16em;
    }
    .hero-metric__note {
      display: inline-block;
      margin-top: 0.4rem;
      font-size: 0.72rem;
      color: var(--color-muted);
      opacity: 0.75;
      border-bottom: 1px dotted var(--color-border);
      cursor: help;
    }

    .hero h1 {
      font-family: var(--font-heading);
      font-size: clamp(1.7rem, 3.4vw, 2.3rem);
      font-weight: 700;
      line-height: 1.4;
      margin: 1.5rem 0 1.75rem;
    }
    .hero h1 .accent { color: var(--color-accent); }
    .hero-lede {
      font-size: clamp(0.95rem, 1.3vw, 1.05rem);
      color: var(--color-muted);
      max-width: 42em;
      margin: 0 0 1.5rem;
      line-height: 1.9;
    }
    .hero-lede strong {
      color: var(--color-text);
      font-weight: 600;
    }
    /* #314-follow-up: FCペルソナ情報（IT意思決定層/ESG企業）を直接的な
       「〇〇へ。」宛先表記ではなく、ベネフィットタグとして訴求する */
    .hero-value-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin: 0 0 2.5rem;
    }
    .value-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1.1rem;
      border-radius: 999px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      font-size: 0.85rem;
      color: var(--color-text-soft);
    }
    /* 絵文字はフォント環境依存で表示されないケースがあるため、
       CSS content の記号（既存 .green-list li::before と同じパターン）で統一 */
    .value-tag::before {
      content: '●';
      color: var(--color-green);
      font-size: 0.7rem;
    }
    .hero-cta {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    /* #316: トップページ .btn の transition（0.25s var(--ease)、複数プロパティ個別指定）
       と一致させる */
    .btn {
      display: inline-block;
      padding: 14px 32px;
      border-radius: var(--radius);
      font-size: 0.95rem;
      font-weight: 600;
      transition: transform 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
    }
    .btn-primary {
      background: var(--color-accent);
      color: #ffffff;
    }
    .btn-primary:hover { background: var(--color-accent2); transform: translateY(-2px); }
    .btn-secondary {
      border: 1px solid var(--color-border);
      color: var(--color-text);
    }
    .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); transform: translateY(-2px); }

    /* SECTION common */
    section {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 90px 24px;
    }
    .section-head {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 56px;
    }
    .section-eyebrow {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      color: var(--color-accent);
      margin-bottom: 14px;
    }
    .section-head h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.6rem, 3.5vw, 2.2rem);
      margin-bottom: 16px;
    }
    .section-head p {
      color: var(--color-muted);
      line-height: 1.8;
    }

    /* PROBLEM */
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
    }
    .problem-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 28px;
    }
    .problem-card .label {
      font-size: 0.75rem;
      color: var(--color-accent);
      letter-spacing: 0.06em;
      margin-bottom: 10px;
    }
    .problem-card p {
      color: var(--color-muted);
      font-size: 0.92rem;
      line-height: 1.75;
    }

    /* ARCHITECTURE (大脳×反射) */
    .arch-wrap {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 28px;
    }
    .arch-card {
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 32px;
    }
    .arch-card h3 {
      font-family: var(--font-heading);
      font-size: 1.2rem;
      margin-bottom: 12px;
      color: var(--color-accent2);
    }
    .arch-card p {
      color: var(--color-muted);
      font-size: 0.92rem;
      line-height: 1.8;
    }
    .arch-card .metric {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid var(--color-border);
      font-size: 0.8rem;
      color: var(--color-muted);
    }
    .arch-card .metric strong {
      display: block;
      font-size: 1.6rem;
      color: var(--color-text);
      margin-bottom: 4px;
    }

    /* GREEN */
    .green-box {
      background: linear-gradient(135deg, rgba(31,157,85,0.08), rgba(244,249,243,0));
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 40px;
    }
    .green-list {
      list-style: none;
      display: grid;
      gap: 16px;
      margin-top: 24px;
    }
    .green-list li {
      display: flex;
      gap: 12px;
      color: var(--color-muted);
      font-size: 0.92rem;
      line-height: 1.75;
    }
    .green-list li::before {
      content: '●';
      color: var(--color-accent);
      flex-shrink: 0;
    }

    /* NOTE (数値主張の注記) */
    .note {
      margin-top: 28px;
      padding: 16px 20px;
      background: rgba(15, 61, 36, 0.04);
      border-left: 3px solid var(--color-border);
      border-radius: 4px;
      font-size: 0.78rem;
      color: var(--color-muted);
      line-height: 1.7;
    }

    /* FLOW */
    .flow {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-size: 0.85rem;
      color: var(--color-muted);
      text-align: center;
    }
    .flow .step {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 14px 20px;
    }
    .flow .arrow { color: var(--color-accent); }

    /* CTA */
    .cta-section {
      text-align: center;
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .cta-section h2 {
      font-family: var(--font-heading);
      font-size: clamp(1.5rem, 3vw, 2rem);
      margin-bottom: 16px;
    }
    .cta-section p {
      color: var(--color-muted);
      margin-bottom: 32px;
    }

    footer {
      text-align: center;
      padding: 40px 24px;
      color: var(--color-muted);
      font-size: 0.8rem;
    }

    /* #314: レスポンシブ対応（entreprenais.com トップページの 720px/820px
       ブレークポイントに準拠） */
    @media (max-width: 720px) {
      .nav-links { display: none; }
      .hero {
        min-height: auto;
        padding: 6.5rem 20px 3rem;
      }
      .hero-metric {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
      }
      .hero-metric__value {
        font-size: clamp(3.4rem, 22vw, 5.5rem);
      }
      .hero-glow--a, .hero-glow--b {
        width: 260px;
        height: 260px;
      }
      section {
        padding: 56px 20px;
      }
      .arch-wrap, .problem-grid {
        grid-template-columns: 1fr;
      }
      .flow {
        flex-direction: column;
        align-items: stretch;
      }
      .flow .arrow {
        transform: rotate(90deg);
      }
      .hero-cta, .hero-value-tags {
        flex-direction: column;
        align-items: flex-start;
      }
      .btn {
        width: 100%;
        text-align: center;
      }
      /* #322/#387: モバイルでは hero-visual-row（チャットプレビュー＋KPIカード）
         を1カラムに変更。chat-preview は「背景のような感じ」（msg344）として
         hero-col-text の背後に溶け込ませ、KPIカードはその下にフルワイド表示
         する（実際の速度・データ訴求はKPIカードで維持しつつ、操作可能な
         チャットUIはモバイルでは既存の画面右下フローティングボタンに一本化）。 */
      .hero-grid-layout {
        position: relative;
      }
      .hero-col-text {
        position: relative;
        z-index: 1;
      }
      .hero-visual-row {
        grid-template-columns: 1fr;
        position: relative;
      }
      .chat-preview {
        position: absolute;
        inset: 0;
        z-index: 0;
        opacity: 0.16;
        pointer-events: none;
        border: none;
        box-shadow: none;
        overflow: hidden;
      }
      .chat-preview__cta,
      .chat-preview__note {
        display: none;
      }
      .kpi-card {
        position: relative;
        z-index: 1;
      }
    }
    @media (max-width: 420px) {
      .hero-metric__value {
        font-size: clamp(2.8rem, 24vw, 4.2rem);
      }
    }
  </style>

  <!-- NAV -->
  <nav>
    <div class="nav-inner">
      <div class="nav-logo">Entrepren<span>AIs</span> Cloud</div>
      <ul class="nav-links">
        <li><a href="#architecture">アーキテクチャ</a></li>
        <li><a href="#green">グリーン</a></li>
        <li><a href={`${BASE}/`}>entreprenais.com</a></li>
      </ul>
    </div>
  </nav>

  <!-- HERO（#314: 「反射層」等の内部構造用語を排除し、価値訴求に特化。
       0.4ms 大型演出は維持しつつラベルを顧客価値視点の文言に変更） -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-grid"></span>
      <span class="hero-glow hero-glow--a"></span>
      <span class="hero-glow hero-glow--b"></span>
    </div>
    <div class="hero-content">
      <div class="hero-grid-layout">
        <div class="hero-col-text">
          <span class="hero-eyebrow reveal" data-reveal>GREEN AI CLOUD</span>

          <div class="hero-metric reveal" data-reveal data-delay="100">
            <span class="hero-metric__value">0.4<span style="font-size: 0.4em;">ms</span></span>
            <span class="hero-metric__label">
              で応答する、超高速エージェント基盤<br />
              <span class="hero-metric__note" title="自社計測値です。計測条件（レスポンスの定義・ベンチマーク環境・再現性）は今後対外開示の透明性を高めていく予定であり、すべてのリクエストがこの数値で応答することを保証するものではありません。">自社計測値・計測条件は継続整備中 ⓘ</span>
            </span>
          </div>

