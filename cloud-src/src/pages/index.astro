---
// src/pages/index.astro — entreprenais-cloud-astro
// entreprenais.com/cloud 「グリーンAIクラウド」LP（#303）
// リーンキャンバス出典: taru0216/taruishi-llc#2139
// 将来のLP差し替えを前提とし、コピー内容はこのファイル + BaseLayout.astro のみで完結する
//
// #341: FC承認デザインモックアップ（EntreprenAIs_Green_AI_Cloud）への全面リライト。
// ビジュアルデザイン（配色・タイポグラフィ・レイアウト・余白）はモックアップに完全準拠。
// #345: FC指摘「文言をモックに合わせて」「LIVE DEMOのアニメーションが消えている」を受け、
// モックアップ原文（eai/tmp/1785981249-EntreprenAIs_Green_AI_Cloud.html、Bundled Page形式・
// JSON文字列エスケープされたHTML）をPythonで正確にデコードして一字一句のコピーを転記し、
// LIVE DEMOセクションをモックアップの `Component`（DCLogicベースの独自コンポーネント）が
// 実装していた自動再生ロジック（SCRIPT配列10問をタイプライター演出でサイクルする対話型
// デモ）をVanilla JSで再現した。
// 機能実装（お問合せAIチャットウィジェット埋め込み・ヒーロー背景写真・reveal/KPIメーター
// アニメーション）は BaseLayout.astro 側のスクリプトをそのまま流用する。
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>

  <style>
    /* ============ NAV ============ */
    /* #372: タグセレクタ `nav` はフッタ内の <nav aria-label="フッターナビゲーション">
       にも継承され、ダーク背景のフッタにライトベージュの半透明ボックスが誤って
       浮いて見える不具合の原因だった。ヘッダー専用の .site-nav クラスにスコープを
       限定し、フッタの <nav> には影響しないようにする。 */
    nav.site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(247, 246, 241, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 clamp(16px, 3vw, 40px);
      height: 66px;
      display: flex;
      align-items: center;
      gap: clamp(12px, 2vw, 36px);
    }
    /* #345: モックアップ原文のロゴ表記「T ・ TDRI ｜ EntreprenAIs Cloud」に合わせる */
    .nav-logo {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .nav-logo__t { font-weight: 900; font-size: 22px; letter-spacing: -0.01em; color: var(--color-text); }
    .nav-logo__dot {
      width: 5px; height: 5px; border-radius: 999px;
      background: var(--color-accent);
      display: inline-block;
      margin-left: -8px;
    }
    .nav-logo__tdri {
      font-family: var(--font-heading);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-text);
    }
    .nav-logo__sep { width: 1px; height: 14px; background: var(--color-border); display: inline-block; margin: 0 4px; }
    .nav-logo__product { font-size: 13px; font-weight: 500; letter-spacing: 0.06em; color: var(--color-text-soft); }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin-left: auto;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-links a {
      flex: none;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-text-soft);
      transition: background 0.2s var(--ease), color 0.2s var(--ease);
    }
    .nav-links a:hover { background: var(--color-accent-tint); color: var(--color-accent2); }
    .nav-cta {
      flex: none;
      margin-left: 12px;
      padding: 11px 22px;
      border-radius: 999px;
      background: var(--color-text);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .nav-cta:hover { color: #fff; background: var(--color-accent2); }
    /* #376: 言語切替導線。日本語（root）/ 英語（/en/）/ 中国語（/zh/）の
       3ページ間を行き来できるよう nav 右端（CTA の左）に配置する。
       旧トップページの .lang-nav（style.css）は暗背景トークンで /cloud の
       ライトテーマ（.site-nav）とは配色が異なるため、cloud 側の
       --color-* トークンに合わせて新規に定義する。 */
    .cloud-lang-nav {
      display: flex;
      align-items: center;
      gap: 2px;
      margin-left: 8px;
      flex: none;
    }
    .cloud-lang-nav a {
      padding: 5px 9px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 500;
      color: var(--color-muted);
      border: 1px solid transparent;
      transition: opacity 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
    }
    .cloud-lang-nav a:hover { color: var(--color-accent2); }
    .cloud-lang-nav a[aria-current="page"] {
      color: var(--color-text);
      border-color: var(--color-border);
      font-weight: 700;
    }
    @media (max-width: 720px) {
      .cloud-lang-nav { display: none; }
    }

    /* ============ HERO ============ */
    /* #387: FC指摘「トップページがファーストビューに入りきらない」。
       ノートPC相当のビューポート（1280x800〜1440x900 程度）で CTA ボタンが
       画面外に見切れていた。padding-top の clamp 上限を 150px→116px に、
       下限を 108px→88px に縮小し、後続の見出し・余白調整と合わせて
       ファーストビューの縦幅を圧縮する（デスクトップの見た目バランスは
       維持しつつ全体を詰める方向で調整）。 */
    .hero {
      position: relative;
      padding: clamp(88px, 10vw, 116px) clamp(20px, 4vw, 40px) 0;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-glow--a {
      position: absolute;
      top: -220px; right: -160px;
      width: 760px; height: 760px;
      border-radius: 999px;
      background: radial-gradient(circle, var(--color-accent-tint) 0%, rgba(230,229,239,0) 68%);
    }
    .hero-photo-bg {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: auto;
      opacity: 0.5;
    }
    .hero-photo-bg--mobile { display: none; }
    .hero-inner {
      position: relative;
      max-width: var(--max-w);
      margin: 0 auto;
      z-index: 1;
    }
    /* #387: margin-bottom 30px→20px（ファーストビュー高さ圧縮の一環） */
    .hero-eyebrow-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
    }
    .hero-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-accent2);
    }
    .hero-eyebrow-rule {
      height: 1px;
      flex: 1;
      max-width: 120px;
      background: var(--color-border);
    }
    /* #370: ヘッダー直下・右寄せの最新ニュース1件ピル。root（entreprenais.com
       トップページ）の .hero__news-pill と同じ配置意図（ヒーロー右上・絶対配置）を
       /cloud のライトテーマ配色（--color-border/--color-text/--color-muted/
       --font-mono）に合わせて移植する。.hero は overflow:hidden のため、
       overflow 制約のない .hero-inner（position:relative）を配置基準にする。 */
    .hero-news-pill {
      position: absolute;
      /* #379: FC指摘「ニューステロップの位置が太陽光、水力と高さが被ってる」。
         top:0 だと通常フローで配置される .hero-eyebrow-row（太陽光+水力の
         hero-live-badge を含む）と同じ高さになり重なって見えていた。
         .hero の padding-top（clamp(108px, 13vw, 150px)）の余白を利用し、
         ニューステロップをヘッダー直下・さらに右上へ引き上げて分離する。 */
      top: -56px;
      right: 0;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: 0.6em;
      padding: 0.4em 0.95em;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: #fff;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.02em;
      color: var(--color-muted);
      text-decoration: none;
      transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
    }
    .hero-news-pill time { font-feature-settings: "tnum"; }
    .hero-news-pill__title { color: var(--color-text); font-weight: 500; }
    .hero-news-pill:hover { border-color: var(--color-accent); color: var(--color-text); }
    .hero-news-pill:hover .hero-news-pill__title { color: var(--color-accent2); }
    @media (max-width: 720px) {
      /* #377: FC指摘「レスポンシブのスマホビューが少しごちゃごちゃしてる」を受け、
         ヒーロー内の情報階層を整理。ニューステロップはモバイルでは非表示にし
         見出し（タグライン）を主役にする（デスクトップは従来どおり表示）。 */
      .hero-news-pill { display: none; }
    }
    .hero-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px 6px 12px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--color-text-soft);
    }
    .hero-live-dot {
      width: 6px; height: 6px; border-radius: 999px;
      background: var(--color-green);
      animation: eaiPulse 2.4s ease-in-out infinite;
    }
    @keyframes eaiPulse {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.35); }
    }
    @keyframes eaiSpin { to { transform: rotate(360deg); } }
    @keyframes eaiCaret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    .hero-flex {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(28px, 5vw, 64px);
      align-items: center;
    }
    /* #352: .hero-col-phone 側が max-width:300px で頭打ちになる一方、旧実装は
       両カラムとも flex-grow:1（均等配分）だったため、コンテナの余剰スペースが
       頭打ち後も無駄に .hero-col-phone 側へ配分され続け、.hero-col-text の実効幅が
       不足して見出し2行目「グリーンAIクラウド、始動」がデスクトップ幅（1440/1920px）
       でも折り返される不具合があった。flex-grow を非対称にし、余剰スペースを
       テキスト側に優先配分することで解消する。 */
    .hero-col-text { flex: 3 1 480px; min-width: 0; }
    .hero h1 {
      margin: 0;
      font-family: var(--font-heading);
      font-size: clamp(34px, 4.6vw, 68px);
      line-height: 1.14;
      font-weight: 900;
      letter-spacing: -0.015em;
      text-wrap: balance;
    }
    /* #349/#352: 各行（「超高速、超省電力」/ グリーンAIクラウド、始動）は
       display:block で明示的に分離しているため単独では折り返さない想定。
       text-wrap: balance を維持しつつ nowrap は使わない（縦幅の狭い実機での
       はみ出しを避けるため、ブラウザ側の自動折り返しは許容する）。 */
    /* #354: FC 指摘「「、始動」は黒で良い」。2行目内で「グリーンAIクラウド」
       （青 = --color-accent）と「、始動」（黒 = --color-text、h1本体の色を継承）
       に分色するため、行分離用の .hero-h1-line2 と、色指定用の .accent を分離する。 */
    .hero h1 .hero-h1-line2 { display: block; color: var(--color-text); }
    .hero h1 .accent { color: var(--color-accent); }
    /* #387: margin-top 30px→18px、line-height 1.85→1.7（ファーストビュー高さ圧縮） */
    .hero-lede {
      margin: 18px 0 0;
      max-width: 46ch;
      font-size: 19px;
      line-height: 1.7;
      color: var(--color-text-soft);
    }
    .hero-lede strong { color: var(--color-text); font-weight: 700; }
    /* #387: margin-top 38px→24px（ファーストビュー高さ圧縮。CTAボタンが
       ノートPC相当ビューポートで画面外に見切れていた問題への対応） */
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }
    /* #354/#358: FC指摘「0.5msが小さくなった。独立して拡大・強調」
       →「右上にスペースがあるのでここが良さそう」を受け、ヒーロー右上
       （iPhoneフレームカラムの上部）に配置。モックアップの巨大「0.5」+「ms」を
       参考に、アクセント色の大型数字 + 補足ノートで構成。 */
    .hero-metric-standalone {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      align-self: flex-end;
      margin-bottom: 4px;
    }
    .hero-metric-standalone__value {
      font-family: var(--font-heading);
      font-size: clamp(56px, 7vw, 96px);
      line-height: 0.82;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--color-accent);
    }
    .hero-metric-standalone__unit {
      font-size: clamp(18px, 2vw, 26px);
      line-height: 1;
      font-weight: 900;
      color: var(--color-text);
      margin-top: 8px;
    }
    .hero-metric-standalone__note {
      margin-left: 6px;
      margin-top: 8px;
      font-family: var(--font-mono);
      font-size: 10.5px;
      line-height: 1.8;
      letter-spacing: 0.03em;
      color: var(--color-muted);
    }
    .btn {
      display: inline-block;
      border-radius: 999px;
      font-weight: 700;
      font-family: inherit;
      text-align: center;
      transition: transform 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
    }
    .btn-primary {
      padding: 16px 30px;
      background: var(--color-text);
      border: none;
      color: #fff;
      font-size: 15px;
      letter-spacing: 0.02em;
      cursor: pointer;
    }
    .btn-primary:hover { background: var(--color-accent2); color: #fff; transform: translateY(-2px); }
    .btn-secondary {
      padding: 14px 28px;
      border: 2px solid var(--color-text);
      color: var(--color-text);
      font-size: 15px;
    }
    .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); transform: translateY(-2px); }

    /* ヒーロー右側: iPhone風デバイスフレームによるチャットデモ（#350）
       root（entreprenais.com トップ）の .phone-mock SSOT を移植。
       ノッチ + 角丸フレーム + チャットプレビュー + CTA という構造は同一で、
       CTA は BaseLayout.astro の openContactWidget() 経由で実物ウィジェット
       （.__eai-widget-btn）を開く。iframe埋め込みではない
       （widget.js は body 直下に fixed floating button を生成する設計のため、
       フレーム内に本体を iframe 化することはできない）。 */
    .hero-col-phone {
      flex: 1 1 300px;
      max-width: 300px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .hero-phone-mock {
      position: relative;
      width: 100%;
      max-width: 300px;
      background: #0d0f12;
      padding: 14px 14px 20px;
      border-radius: 38px;
      border: 1px solid rgba(74, 74, 226, 0.22);
      box-shadow:
        0 32px 60px -28px rgba(42, 45, 124, 0.35),
        0 12px 24px -12px rgba(13, 15, 18, 0.22);
    }
    .hero-phone-mock__notch {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 78px;
      height: 6px;
      border-radius: 999px;
      background: rgba(247, 246, 241, 0.08);
      z-index: 2;
    }
    /* #362: FC指摘「会話のたびにiPhoneが縦に伸びていきます。iPhoneは固定で中の
       チャットが動くんですよね」。min-height のみでは上限がなく、
       .hero-phone-mock__msgs の内容が増えるたびに .hero-phone-mock__screen
       （ひいては外枠 .hero-phone-mock 全体）が伸び続けていた。
       LIVE DEMO の .demo-card__body（height 固定 + overflow-y:auto）と同じ
       パターンに揃え、height を固定してフレームサイズを不変にする。
       #362 追加調整: FC指摘「iPhoneの高さが少し低いよね。もう少し縦長に」を
       受け、360px→460px に拡大（実機のiPhone比率 約1:2.16 には寄せすぎず、
       .hero-metric-standalone・見出し・本文とのバランスを保てる範囲で調整）。 */
    /* #366: FC指摘「もう一段縦長に」（#362 で360px→460pxに拡大済み）。
       実機iPhoneの比率（約1:2.16）に近づけ、580pxへ再拡大。 */
    .hero-phone-mock__screen {
      position: relative;
      border-radius: 26px;
      background: var(--color-dark-bg);
      overflow: hidden;
      padding: 30px 14px 16px;
      height: 580px;
      display: flex;
      flex-direction: column;
    }
    .hero-phone-mock__badge {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(74, 74, 226, 0.18);
      color: var(--color-accent-light);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.05em;
    }
    /* #358: FC指摘「LIVE DEMOの10ターンのチャットのデモが重要」「それと同じターンを
       iPhone にも出す」を受け、独自演出（フェードイン・浮遊、#354）を撤回し、
       LIVE DEMO（#demo）と同一の SCRIPT 配列を own側のみ再生するタイプライター演出に
       置き換えた。.hero-phone-mock__msgs は会話ログのスクロール領域（縦スクロール、
       auto-stick）で、吹き出しは JS（heroPhoneTurn、ページ末尾スクリプト）が動的生成する。 */
    .hero-phone-mock__msgs {
      margin-top: 14px;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      scrollbar-width: none;
    }
    .hero-phone-mock__msgs::-webkit-scrollbar { display: none; }
    /* #366: FC指摘「iPhone の中身が真っ暗です」。.hero-phone-mock__msg 以下
       （吹き出し本体）は JS（heroPhoneTurn）が document.createElement で動的生成する
       要素であり、Astro の scoped CSS（コンパイル時に静的要素へ注入される
       data-astro-cid-* 属性ベースのセレクタ）が一切マッチせず、背景色・文字色が
       無効化されていた（DOM上は正しく存在するが computed style が
       background:transparent + 暗い文字色になり、暗いフレーム背景と同化して不可視化）。
       Issue #347（LIVE DEMOの .demo-bubble--user/--ai で発生した同一パターン）と
       同じ原因のため、同じ対応（is:global ブロックへの切り出し）を適用する。
       定義は下記の <style is:global> ブロックを参照。 */
    .hero-phone-mock__ms {
      margin-top: 14px;
      padding-top: 14px;
      display: flex;
      align-items: baseline;
      gap: 6px;
      border-top: 1px solid var(--color-dark-border);
      flex: none;
    }
    .hero-phone-mock__ms-value {
      font-family: var(--font-heading);
      font-size: 30px;
      font-weight: 900;
      color: var(--color-accent-light);
      letter-spacing: -0.02em;
    }
    .hero-phone-mock__ms-label {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-dark-muted);
      line-height: 1.5;
    }
    .hero-phone-note {
      max-width: 300px;
      text-align: center;
      font-size: 11.5px;
      line-height: 1.7;
      color: var(--color-muted);
    }
    /* details/summary（モックアップのアコーディオン注記表示を踏襲） */
    details.hero-details { margin: 14px 0 0; }
    details.hero-details summary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--color-muted);
      cursor: pointer;
    }
    details.hero-details summary:hover { color: var(--color-text); }
    details.hero-details p {
      margin: 12px 0 0;
      max-width: 88ch;
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--color-muted);
    }

    /* ============ SECTION common ============ */
    .section-light {
      padding: clamp(72px, 10vw, 110px) clamp(20px, 4vw, 40px);
      scroll-margin-top: 66px;
    }
    .section-dark {
      padding: clamp(72px, 10vw, 104px) clamp(20px, 4vw, 40px) clamp(72px, 10vw, 110px);
      background: var(--color-dark-bg);
      scroll-margin-top: 66px;
    }
    .section-inner { max-width: var(--max-w); margin: 0 auto; }
    .eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .eyebrow.on-dark { color: var(--color-accent-light); }
    h2.headline {
      margin: 18px 0 0;
      font-size: clamp(27px, 3.6vw, 46px);
      line-height: 1.3;
      font-weight: 900;
      letter-spacing: -0.005em;
    }
    h2.headline.narrow { max-width: 26ch; }
    h2.headline .accent { color: var(--color-accent); }
    /* #370 followup: FC指摘「ABOUTの会社名も背景と文字色が同じで見えない」。
       h2.headline は color 未指定のため body の既定文字色（暗色 --color-text）を
       継承する。.section-dark（暗背景）内で使う場合、これまで #demo/#architecture の
       h2 は個別にインライン style="color:var(--color-dark-text)" を付与して回避していたが、
       ABOUT セクション追加時（#368）にこの付与が漏れ、暗背景×暗文字でコントラスト
       不足となった。LIVE DEMO吹き出し（#347）・CTAボタン（#350 followup）でも同種の
       コントラスト不足が繰り返し発生しているため、都度のインライン style ではなく
       .section-dark 配下の h2.headline に既定で明色を当てるセレクタを追加し、
       同じ見落としの再発を構造的に防ぐ。既存のインライン style（#demo/#architecture）は
       同値のため無害だが、そのまま残してもこのルールと衝突しない。 */
    .section-dark h2.headline { color: var(--color-dark-text); }
    .section-lede {
      margin: 20px 0 0;
      max-width: 60ch;
      font-size: 17px;
      line-height: 1.9;
      color: var(--color-text-soft);
    }
    .section-lede.on-dark { color: var(--color-dark-text-soft); }
    .note {
      margin-top: 22px;
      padding-top: 24px;
      border-top: 1px solid var(--color-border);
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--color-muted);
      max-width: 96ch;
    }
    .note.on-dark { border-top-color: var(--color-dark-border); color: var(--color-dark-muted); }
    .note strong { color: var(--color-text-soft); }
    .note.on-dark strong { color: var(--color-dark-text-soft); }
    details.note-details { margin-top: 22px; }
    details.note-details.on-dark { padding-top: 22px; border-top: 1px solid var(--color-dark-border); margin-top: 18px; }
    details.note-details summary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--color-muted);
      cursor: pointer;
    }
    details.note-details.on-dark summary { font-size: 13px; font-weight: 700; color: var(--color-dark-text-soft); }
    details.note-details summary:hover { color: var(--color-text); }
    details.note-details.on-dark summary:hover { color: var(--color-dark-text); }
    details.note-details .note-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 26px;
      margin-top: 22px;
    }
    details.note-details .note-grid p { margin: 0; font-size: 12.5px; line-height: 1.9; color: var(--color-dark-muted); }
    details.note-details .note-grid p strong { color: var(--color-dark-text-soft); }
    details.note-details > p { margin: 12px 0 0; max-width: 88ch; font-size: 12.5px; line-height: 1.9; color: var(--color-muted); }

    /* PROBLEM（3カード） */
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(268px, 1fr));
      gap: 20px;
      margin-top: 56px;
    }
    .problem-card {
      padding: 34px;
      background: #fff;
      border: 1px solid var(--color-border2);
      border-radius: 22px;
    }
    .problem-card__label {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--color-accent2);
    }
    .problem-card h3 {
      margin: 16px 0 0;
      font-size: 23px;
      font-weight: 700;
      line-height: 1.5;
    }
    .problem-card p {
      margin: 14px 0 0;
      font-size: 14.5px;
      line-height: 1.9;
      color: var(--color-text-soft);
    }

    /* LIVE DEMO（ダーク・チャットUIカード2枚 + 自動再生アニメーション） */
    .demo-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
    .demo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 24px;
      margin-top: 44px;
    }
    .demo-card {
      border: 1px solid var(--color-dark-border);
      border-radius: 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .demo-card.is-ours { background: var(--color-dark-navy); }
    .demo-card.is-cloud { background: var(--color-dark-surface); }
    .demo-card__head {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px 22px;
      border-bottom: 1px solid var(--color-dark-border2);
      background: var(--color-dark-card);
    }
    .demo-card.is-cloud .demo-card__head {
      border-bottom-color: var(--color-dark-border);
      background: var(--color-dark-slate);
    }
    .demo-card__dot { width: 8px; height: 8px; border-radius: 999px; }
    .demo-card.is-ours .demo-card__dot { background: var(--color-green); }
    .demo-card.is-cloud .demo-card__dot { background: var(--color-orange); }
    .demo-card__title { font-size: 13px; font-weight: 700; color: var(--color-dark-text); }
    .demo-card__badge {
      padding: 3px 9px;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 9.5px;
      letter-spacing: 0.06em;
    }
    .demo-card.is-ours .demo-card__badge { border: 1px solid var(--color-green); color: var(--color-green); }
    .demo-card.is-cloud .demo-card__badge { border: 1px solid var(--color-dark-border3); color: var(--color-dark-muted2); }
    .demo-card__turnlabel {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: 10.5px;
    }
    .demo-card.is-ours .demo-card__turnlabel { color: var(--color-green); }
    .demo-card.is-cloud .demo-card__turnlabel { color: var(--color-orange); }
    .demo-card__body {
      flex: none;
      height: clamp(300px, 42vh, 392px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .demo-idle {
      margin: auto;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 11.5px;
      line-height: 2;
      color: var(--color-muted);
    }
    .demo-card__footer {
      padding: 20px 24px;
      border-top: 1px solid var(--color-dark-border2);
      background: var(--color-dark-card);
      display: flex;
      align-items: baseline;
      gap: 12px;
    }
    .demo-card.is-cloud .demo-card__footer {
      border-top-color: var(--color-dark-border);
      background: var(--color-dark-slate);
    }
    .demo-card__footer-value {
      font-size: clamp(38px, 4vw, 52px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.03em;
    }
    .demo-card.is-ours .demo-card__footer-value { color: var(--color-accent-light); }
    .demo-card.is-cloud .demo-card__footer-value { color: var(--color-dark-muted2); }
    .demo-card__footer-unit { font-size: 18px; font-weight: 900; color: var(--color-dark-text); }
    .demo-card__footer-note {
      margin-left: auto;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-dark-muted);
      text-align: right;
    }

    /* ARCHITECTURE（ダーク・3要素 + sticky KPIサイドバー） */
    .arch-flex {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(32px, 5vw, 70px);
      align-items: flex-start;
    }
    .arch-col-main { flex: 1 1 520px; min-width: 0; }
    .arch-sub {
      margin-top: 14px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      color: var(--color-accent-light);
    }
    .arch-card-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 44px;
    }
    .arch-card {
      display: flex;
      gap: 20px;
      padding: 30px;
      background: var(--color-dark-surface);
      border: 1px solid var(--color-dark-border);
      border-radius: 20px;
    }
    .arch-card.is-highlight {
      background: var(--color-dark-navy);
      border-color: var(--color-dark-navy-border);
    }
    .arch-card__icon {
      flex: none;
      width: 52px; height: 52px;
      border-radius: 14px;
      background: rgba(123,123,240,0.14);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono);
      font-size: 13px; font-weight: 700;
      color: var(--color-accent-light);
    }
    .arch-card.is-highlight .arch-card__icon { background: rgba(71,199,117,0.14); color: var(--color-green); }
    .arch-card h3 { margin: 0; font-size: 21px; font-weight: 700; color: var(--color-dark-text); }
    .arch-card p { margin: 12px 0 0; font-size: 14.5px; line-height: 1.9; color: var(--color-dark-text-soft); }
    .arch-connector {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 6px;
      color: var(--color-dark-border3);
      font-size: 18px;
    }
    .arch-connector-line { height: 1px; flex: 1; background: var(--color-dark-border); }
    .arch-connector-label { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.16em; color: var(--color-accent-light); }

    .arch-sidebar {
      flex: 1 1 320px;
      max-width: 460px;
      position: sticky;
      top: 110px;
      padding: clamp(28px, 3vw, 44px);
      background: var(--color-dark-surface);
      border: 1px solid var(--color-dark-border);
      border-radius: 24px;
    }
    .arch-sidebar__label {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--color-dark-muted);
    }
    .arch-sidebar__metric {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-top: 20px;
    }
    .arch-sidebar__value {
      font-size: clamp(78px, 9vw, 110px);
      line-height: 0.86;
      font-weight: 900;
      letter-spacing: -0.05em;
      color: var(--color-accent-light);
    }
    .arch-sidebar__unit { font-size: 30px; font-weight: 900; color: var(--color-dark-text); margin-top: 8px; }
    .arch-sidebar__desc { margin: 22px 0 0; font-size: 13.5px; line-height: 1.9; color: var(--color-dark-text-soft); }
    .arch-sidebar__list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 26px;
      padding-top: 24px;
      border-top: 1px solid var(--color-dark-border);
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--color-dark-muted);
    }
    .arch-sidebar__row { display: flex; justify-content: space-between; }
    .arch-sidebar__row .v { color: var(--color-dark-text); }
    .arch-sidebar__row .v.is-green { color: var(--color-green); }
    details.arch-details { margin-top: 24px; }
    details.arch-details summary { font-size: 12px; color: var(--color-dark-muted); cursor: pointer; }
    details.arch-details summary:hover { color: var(--color-dark-text); }
    details.arch-details p { margin: 12px 0 0; font-size: 12px; line-height: 1.85; color: var(--color-dark-muted); }

    /* GREEN（4カード） */
    .green-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(288px, 1fr));
      gap: 20px;
      margin-top: 52px;
    }
    .green-card {
      padding: 34px;
      background: #fff;
      border: 1px solid var(--color-border2);
      border-radius: 22px;
    }
    .green-card__icon {
      width: 44px; height: 44px;
      border-radius: 12px;
      background: var(--color-accent-tint);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono);
      font-size: 11px; font-weight: 700;
      color: var(--color-accent2);
    }
    .green-card h3 { margin: 18px 0 0; font-size: 20px; font-weight: 700; }
    .green-card p { margin: 12px 0 0; font-size: 14.5px; line-height: 1.9; color: var(--color-text-soft); }

    /* FLOW（「制約が両立を生んだ」まとめボックス） */
    .flow-box {
      margin-top: clamp(56px, 8vw, 86px);
      padding: clamp(28px, 4vw, 60px);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 28px;
    }
    .flow-box h3 {
      margin: 16px 0 0;
      font-size: clamp(24px, 2.8vw, 34px);
      font-weight: 900;
      letter-spacing: -0.005em;
    }
    .flow-steps {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      align-items: center;
      margin-top: 44px;
    }
    .flow-step {
      flex: 1 1 210px;
      padding: 26px;
      background: #fff;
      border: 1px solid var(--color-border2);
      border-radius: 18px;
      font-size: 14.5px;
      line-height: 1.8;
      font-weight: 700;
    }
    .flow-step.is-final {
      background: var(--color-text);
      border-color: var(--color-text);
      color: var(--color-dark-text);
    }
    .flow-arrow { color: var(--color-muted); font-size: 20px; }
    .flow-arrow.is-accent { color: var(--color-accent); }

    /* CTA */
    .cta-wrap { padding: 0 clamp(20px, 4vw, 40px) clamp(72px, 10vw, 110px); scroll-margin-top: 66px; }
    .cta-box {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: clamp(32px, 5vw, 80px);
      background: var(--color-dark-bg);
      border-radius: 28px;
      display: flex;
      flex-wrap: wrap;
      gap: clamp(28px, 4vw, 60px);
      align-items: center;
    }
    .cta-box__text { flex: 1 1 460px; min-width: 0; }
    .cta-box h2 {
      margin: 0;
      font-size: clamp(27px, 3.4vw, 44px);
      line-height: 1.3;
      font-weight: 900;
      color: var(--color-dark-text);
      letter-spacing: -0.005em;
    }
    .cta-box p { margin: 20px 0 0; max-width: 56ch; font-size: 16px; line-height: 1.9; color: var(--color-dark-text-soft); }
    .cta-box__actions {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1 1 280px;
    }
    .cta-btn-primary {
      padding: 18px 32px;
      border-radius: 999px;
      background: #fff;
      color: var(--color-dark-bg);
      font-size: 15px;
      font-weight: 700;
      text-align: center;
    }
    .cta-btn-primary:hover { color: var(--color-dark-bg); background: var(--color-dark-text-soft); }
    /* #350 followup（FC 指摘「ボタンの中の文字が見えない」）: <button> 要素は
       background 未指定だとブラウザの UA デフォルト背景（明るいグレー、環境により
       rgb(239,239,239) 等）が適用される。アウトラインボタンとして透過背景を意図していたが
       background が未指定だったため、明るい文字色 (--color-dark-text) と UA デフォルトの
       明るい背景が重なりコントラストがほぼ失われていた。background: transparent を明示し
       意図どおりの透過アウトラインにする。 */
    .cta-btn-secondary {
      padding: 16px 30px;
      border-radius: 999px;
      border: 2px solid var(--color-dark-border);
      background: transparent;
      color: var(--color-dark-text);
      font-size: 15px;
      font-weight: 700;
      text-align: center;
    }
    .cta-btn-secondary:hover { color: var(--color-dark-text); border-color: var(--color-accent-light); }
    .cta-box__note { margin-top: 6px; text-align: center; font-size: 13px; color: var(--color-dark-muted); }

    /* #368: ABOUT（entreprenais.com トップページ #about 相当の会社紹介を移植）
       既存 .green-grid / .green-card パターンをそのまま再利用し、3ブロック
       （会社概要・創業の原点・代表プロフィール）をカード表示する。 */
    .about-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(288px, 1fr));
      gap: 20px;
      margin-top: 52px;
    }
    .about-card {
      padding: 34px;
      background: var(--color-dark-surface);
      border: 1px solid var(--color-dark-border);
      border-radius: 22px;
    }
    .about-card h3 { margin: 0; font-size: 20px; font-weight: 700; color: var(--color-dark-text); }
    .about-card p { margin: 14px 0 0; font-size: 14.5px; line-height: 1.9; color: var(--color-dark-text-soft); }
    .about-card p + p { margin-top: 12px; }

    /* #368/#370 followup: NEWS（entreprenais.com トップページ #news 相当の
       ニュース一覧を移植）/data/news.json を取得して最新3件をカード表示する。
       トップページの .news-card 構造・データ形式をそのまま踏襲し、/cloud の
       ライトテーマに合わせて配色調整。
       #370 followup: 本来ここに定義していた .news-card 関連セレクタ一式は
       JS（renderCard、下記スクリプトブロック）が innerHTML で実行時に動的生成する
       要素に適用されるが、Astro の scoped CSS（コンパイル時に静的要素へ注入される
       data-astro-cid-* 属性ベースのセレクタ）は動的生成要素に一切マッチしないため、
       本番でスタイルが丸ごと無効化され、素の <img> がカード幅いっぱいに表示される
       崩れが発生した（FC報告）。LIVE DEMO吹き出し（#347）・ヒーローiPhoneフレーム
       （#366）と同一原因のため、同じ対応（is:global ブロックへの切り出し）を適用する。
       定義は下記 <style is:global> ブロックを参照（.news-list のみ静的要素
       <ul id="cloud-news-list"> に直接付与されているためここに残置）。 */
    .news-list {
      list-style: none;
      margin: 52px 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .news-more { margin-top: 28px; text-align: center; }
    /* #370 followup: FC 指摘「NEWS の『すべてのニュースを見る』が見えない」。
       NEWS セクションは .section-light（明背景）だが、流用した .cta-btn-secondary は
       .cta-box（暗背景 CTA）専用に明文字（--color-dark-text）で設計されたボタンで、
       明背景に重なりコントラストが失われていた。#350 followup で一度直した
       「アウトラインボタンの文字色が背景と同化する」パターンが、明背景コンテキストで
       再発したもの。.news-more 配下限定で暗文字に上書きし、.cta-btn-secondary 本来の
       用途（.cta-box 内）には影響させない。 */
    .news-more .cta-btn-secondary {
      border-color: var(--color-border2);
      color: var(--color-text);
    }
    .news-more .cta-btn-secondary:hover {
      color: var(--color-accent2);
      border-color: var(--color-accent);
    }

    /* FOOTER */
    footer {
      padding: 54px clamp(20px, 4vw, 40px) 40px;
      border-top: 1px solid var(--color-dark-border);
      background: var(--color-dark-bg);
    }
    .footer-inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .footer-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .footer-brand { display: flex; align-items: center; gap: 14px; }
    .footer-brand__mark {
      width: 34px; height: 34px;
      border-radius: 10px;
      background: var(--color-accent);
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-mono);
      font-weight: 700;
      color: #fff;
      flex: none;
    }
    .footer-brand__name { font-size: 14.5px; font-weight: 700; color: var(--color-dark-text); }
    .footer-brand__name-en { margin-top: 2px; font-size: 11.5px; color: var(--color-dark-muted); }
    .footer-nav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px 22px;
    }
    .footer-nav-list a {
      font-size: 12.5px;
      color: var(--color-dark-muted2);
    }
    .footer-nav-list a:hover { color: var(--color-dark-text); }
    .footer-bottom {
      padding-top: 22px;
      border-top: 1px solid var(--color-dark-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      font-size: 12.5px;
      color: var(--color-dark-muted);
    }
