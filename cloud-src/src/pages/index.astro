      /* #391: 電話モックアップ本体（.hero-phone-mock__screen）は 580px
         固定（デスクトップ値を継承）だったため、モバイルでは画面の大半を
         占めていた。320px まで縮小し、フレーム自体も一回り小さくする。 */
      .hero-phone-mock { max-width: 170px; }
