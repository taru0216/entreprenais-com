---
// src/pages/index.astro — entreprenais-cloud-astro
// entreprenais.com/cloud 「グリーンAIクラウド」LP（#303）
// リーンキャンバス出典: taru0216/taruishi-llc#2139
// 将来のLP差し替えを前提とし、コピー内容はこのファイル + BaseLayout.astro のみで完結する
//
// #341: FC承認デザインモックアップ（EntreprenAIs_Green_AI_Cloud）への全面リライト。
// ビジュアルデザイン（配色・タイポグラフィ・レイアウト・余白）はモックアップに完全準拠。
// #345: FC指摘「文言をモックに合わせて」「LIVE DEMOのアニメーションが消えている」を受け、
// モックアップ原文（eai/tmp/1785981249-EntreprenAIs_Green_AI_Cloud.html、Bundled Page形式・
// JSON文字列エスケープされたHTML）をPythonで正確にデコードして一字一句のコピーを転記し、
// LIVE DEMOセクションをモックアップの `Component`（DCLogicベースの独自コンポーネント）が
// 実装していた自動再生ロジック（SCRIPT配列10問をタイプライター演出でサイクルする対話型
// デモ）をVanilla JSで再現した。
// 機能実装（お問合せAIチャットウィジェット埋め込み・ヒーロー背景写真・reveal/KPIメーター
// アニメーション）は BaseLayout.astro 側のスクリプトをそのまま流用する。
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout>

  <style>
    /* ============ NAV ============ */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(247, 246, 241, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
    }
    .nav-inner {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 clamp(16px, 3vw, 40px);
      height: 66px;
      display: flex;
      align-items: center;
      gap: clamp(12px, 2vw, 36px);
    }
    /* #345: モックアップ原文のロゴ表記「T ・ TDRI ｜ EntreprenAIs Cloud」に合わせる */
    .nav-logo {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .nav-logo__t { font-weight: 900; font-size: 22px; letter-spacing: -0.01em; color: var(--color-text); }
    .nav-logo__dot {
      width: 5px; height: 5px; border-radius: 999px;
      background: var(--color-accent);
      display: inline-block;
      margin-left: -8px;
    }
    .nav-logo__tdri {
      font-family: var(--font-heading);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-text);
    }
    .nav-logo__sep { width: 1px; height: 14px; background: var(--color-border); display: inline-block; margin: 0 4px; }
    .nav-logo__product { font-size: 13px; font-weight: 500; letter-spacing: 0.06em; color: var(--color-text-soft); }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      margin-left: auto;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-links a {
      flex: none;
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 500;
      color: var(--color-text-soft);
      transition: background 0.2s var(--ease), color 0.2s var(--ease);
    }
    .nav-links a:hover { background: var(--color-accent-tint); color: var(--color-accent2); }
    .nav-cta {
      flex: none;
      margin-left: 12px;
      padding: 11px 22px;
      border-radius: 999px;
      background: var(--color-text);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .nav-cta:hover { color: #fff; background: var(--color-accent2); }

    /* ============ HERO ============ */
    .hero {
      position: relative;
      padding: clamp(108px, 13vw, 150px) clamp(20px, 4vw, 40px) 0;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }
    .hero-glow--a {
      position: absolute;
      top: -220px; right: -160px;
      width: 760px; height: 760px;
      border-radius: 999px;
      background: radial-gradient(circle, var(--color-accent-tint) 0%, rgba(230,229,239,0) 68%);
    }
    .hero-photo-bg {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: auto;
      opacity: 0.5;
    }
    .hero-photo-bg--mobile { display: none; }
    .hero-inner {
      position: relative;
      max-width: var(--max-w);
      margin: 0 auto;
      z-index: 1;
    }
    .hero-eyebrow-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 30px;
    }
    .hero-eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-accent2);
    }
    .hero-eyebrow-rule {
      height: 1px;
      flex: 1;
      max-width: 120px;
      background: var(--color-border);
    }
    .hero-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px 6px 12px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--color-text-soft);
    }
    .hero-live-dot {
      width: 6px; height: 6px; border-radius: 999px;
      background: var(--color-green);
      animation: eaiPulse 2.4s ease-in-out infinite;
    }
    @keyframes eaiPulse {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.35); }
    }
    @keyframes eaiSpin { to { transform: rotate(360deg); } }
    @keyframes eaiCaret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    .hero-flex {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(28px, 5vw, 64px);
      align-items: center;
    }
    /* #352: .hero-col-phone 側が max-width:300px で頭打ちになる一方、旧実装は
       両カラムとも flex-grow:1（均等配分）だったため、コンテナの余剰スペースが
       頭打ち後も無駄に .hero-col-phone 側へ配分され続け、.hero-col-text の実効幅が
       不足して見出し2行目「グリーンAIクラウド、始動」がデスクトップ幅（1440/1920px）
       でも折り返される不具合があった。flex-grow を非対称にし、余剰スペースを
       テキスト側に優先配分することで解消する。 */
    .hero-col-text { flex: 3 1 480px; min-width: 0; }
    .hero h1 {
      margin: 0;
      font-family: var(--font-heading);
      font-size: clamp(34px, 4.6vw, 68px);
      line-height: 1.14;
      font-weight: 900;
      letter-spacing: -0.015em;
      text-wrap: balance;
    }
    /* #349/#352: 各行（「超高速、超省電力」/ グリーンAIクラウド、始動）は
       display:block で明示的に分離しているため単独では折り返さない想定。
       text-wrap: balance を維持しつつ nowrap は使わない（縦幅の狭い実機での
       はみ出しを避けるため、ブラウザ側の自動折り返しは許容する）。 */
    /* #354: FC 指摘「「、始動」は黒で良い」。2行目内で「グリーンAIクラウド」
       （青 = --color-accent）と「、始動」（黒 = --color-text、h1本体の色を継承）
       に分色するため、行分離用の .hero-h1-line2 と、色指定用の .accent を分離する。 */
    .hero h1 .hero-h1-line2 { display: block; color: var(--color-text); }
    .hero h1 .accent { color: var(--color-accent); }
    .hero-lede {
      margin: 30px 0 0;
      max-width: 46ch;
      font-size: 19px;
      line-height: 1.85;
      color: var(--color-text-soft);
    }
    .hero-lede strong { color: var(--color-text); font-weight: 700; }
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 38px;
    }
    /* #354/#358: FC指摘「0.5msが小さくなった。独立して拡大・強調」
       →「右上にスペースがあるのでここが良さそう」を受け、ヒーロー右上
       （iPhoneフレームカラムの上部）に配置。モックアップの巨大「0.5」+「ms」を
       参考に、アクセント色の大型数字 + 補足ノートで構成。 */
    .hero-metric-standalone {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      align-self: flex-end;
      margin-bottom: 4px;
    }
    .hero-metric-standalone__value {
      font-family: var(--font-heading);
      font-size: clamp(56px, 7vw, 96px);
      line-height: 0.82;
      font-weight: 900;
      letter-spacing: -0.04em;
      color: var(--color-accent);
    }
    .hero-metric-standalone__unit {
      font-size: clamp(18px, 2vw, 26px);
      line-height: 1;
      font-weight: 900;
      color: var(--color-text);
      margin-top: 8px;
    }
    .hero-metric-standalone__note {
      margin-left: 6px;
      margin-top: 8px;
      font-family: var(--font-mono);
      font-size: 10.5px;
      line-height: 1.8;
      letter-spacing: 0.03em;
      color: var(--color-muted);
    }
    .btn {
      display: inline-block;
      border-radius: 999px;
      font-weight: 700;
      text-align: center;
      transition: transform 0.25s var(--ease), background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
    }
    .btn-primary {
      padding: 16px 30px;
      background: var(--color-text);
      color: #fff;
      font-size: 15px;
      letter-spacing: 0.02em;
    }
    .btn-primary:hover { background: var(--color-accent2); color: #fff; transform: translateY(-2px); }
    .btn-secondary {
      padding: 14px 28px;
      border: 2px solid var(--color-text);
      color: var(--color-text);
      font-size: 15px;
    }
    .btn-secondary:hover { border-color: var(--color-accent); color: var(--color-accent); transform: translateY(-2px); }

    /* ヒーロー右側: iPhone風デバイスフレームによるチャットデモ（#350）
       root（entreprenais.com トップ）の .phone-mock SSOT を移植。
       ノッチ + 角丸フレーム + チャットプレビュー + CTA という構造は同一で、
       CTA は BaseLayout.astro の openContactWidget() 経由で実物ウィジェット
       （.__eai-widget-btn）を開く。iframe埋め込みではない
       （widget.js は body 直下に fixed floating button を生成する設計のため、
       フレーム内に本体を iframe 化することはできない）。 */
    .hero-col-phone {
      flex: 1 1 300px;
      max-width: 300px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .hero-phone-mock {
      position: relative;
      width: 100%;
      max-width: 300px;
      background: #0d0f12;
      padding: 14px 14px 20px;
      border-radius: 38px;
      border: 1px solid rgba(74, 74, 226, 0.22);
      box-shadow:
        0 32px 60px -28px rgba(42, 45, 124, 0.35),
        0 12px 24px -12px rgba(13, 15, 18, 0.22);
    }
    .hero-phone-mock__notch {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 78px;
      height: 6px;
      border-radius: 999px;
      background: rgba(247, 246, 241, 0.08);
      z-index: 2;
    }
    /* #362: FC指摘「会話のたびにiPhoneが縦に伸びていきます。iPhoneは固定で中の
       チャットが動くんですよね」。min-height のみでは上限がなく、
       .hero-phone-mock__msgs の内容が増えるたびに .hero-phone-mock__screen
       （ひいては外枠 .hero-phone-mock 全体）が伸び続けていた。
       LIVE DEMO の .demo-card__body（height 固定 + overflow-y:auto）と同じ
       パターンに揃え、height を固定してフレームサイズを不変にする。
       #362 追加調整: FC指摘「iPhoneの高さが少し低いよね。もう少し縦長に」を
       受け、360px→460px に拡大（実機のiPhone比率 約1:2.16 には寄せすぎず、
       .hero-metric-standalone・見出し・本文とのバランスを保てる範囲で調整）。 */
    .hero-phone-mock__screen {
      position: relative;
      border-radius: 26px;
      background: var(--color-dark-bg);
      overflow: hidden;
      padding: 30px 14px 16px;
      height: 460px;
      display: flex;
      flex-direction: column;
    }
    .hero-phone-mock__badge {
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(74, 74, 226, 0.18);
      color: var(--color-accent-light);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.05em;
    }
    /* #358: FC指摘「LIVE DEMOの10ターンのチャットのデモが重要」「それと同じターンを
       iPhone にも出す」を受け、独自演出（フェードイン・浮遊、#354）を撤回し、
       LIVE DEMO（#demo）と同一の SCRIPT 配列を own側のみ再生するタイプライター演出に
       置き換えた。.hero-phone-mock__msgs は会話ログのスクロール領域（縦スクロール、
       auto-stick）で、吹き出しは JS（heroPhoneTurn、ページ末尾スクリプト）が動的生成する。 */
    .hero-phone-mock__msgs {
      margin-top: 14px;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
      scrollbar-width: none;
    }
    .hero-phone-mock__msgs::-webkit-scrollbar { display: none; }
    .hero-phone-mock__msg {
      padding: 10px 13px;
      border-radius: 14px;
      font-size: 12.5px;
      line-height: 1.6;
      max-width: 88%;
    }
    .hero-phone-mock__msg--in {
      align-self: flex-start;
      background: var(--color-dark-surface);
      color: var(--color-dark-text-soft);
      border-bottom-left-radius: 4px;
    }
    .hero-phone-mock__msg--out {
      align-self: flex-end;
      background: var(--color-accent);
      color: #fff;
      border-bottom-right-radius: 4px;
    }
    .hero-phone-caret {
      display: inline-block;
      width: 6px; height: 13px;
      margin-left: 2px;
      background: rgba(255,255,255,0.85);
      vertical-align: -2px;
      animation: eaiCaret 900ms step-end infinite;
    }
    .hero-phone-mock__ms {
      margin-top: 14px;
      padding-top: 14px;
      display: flex;
      align-items: baseline;
      gap: 6px;
      border-top: 1px solid var(--color-dark-border);
      flex: none;
    }
    .hero-phone-mock__ms-value {
      font-family: var(--font-heading);
      font-size: 30px;
      font-weight: 900;
      color: var(--color-accent-light);
      letter-spacing: -0.02em;
    }
    .hero-phone-mock__ms-label {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--color-dark-muted);
      line-height: 1.5;
    }
    .hero-phone-note {
      max-width: 300px;
      text-align: center;
      font-size: 11.5px;
      line-height: 1.7;
      color: var(--color-muted);
    }
    /* details/summary（モックアップのアコーディオン注記表示を踏襲） */
    details.hero-details { margin: 14px 0 0; }
    details.hero-details summary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--color-muted);
      cursor: pointer;
    }
    details.hero-details summary:hover { color: var(--color-text); }
    details.hero-details p {
      margin: 12px 0 0;
      max-width: 88ch;
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--color-muted);
    }

    /* ============ SECTION common ============ */
    .section-light {
      padding: clamp(72px, 10vw, 110px) clamp(20px, 4vw, 40px);
      scroll-margin-top: 66px;
    }
    .section-dark {
      padding: clamp(72px, 10vw, 104px) clamp(20px, 4vw, 40px) clamp(72px, 10vw, 110px);
      background: var(--color-dark-bg);
      scroll-margin-top: 66px;
    }
    .section-inner { max-width: var(--max-w); margin: 0 auto; }
    .eyebrow {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .eyebrow.on-dark { color: var(--color-accent-light); }
    h2.headline {
      margin: 18px 0 0;
      font-size: clamp(27px, 3.6vw, 46px);
      line-height: 1.3;
      font-weight: 900;
      letter-spacing: -0.005em;
    }
    h2.headline.narrow { max-width: 26ch; }
    h2.headline .accent { color: var(--color-accent); }
    .section-lede {
      margin: 20px 0 0;
      max-width: 60ch;
      font-size: 17px;
      line-height: 1.9;
      color: var(--color-text-soft);
    }
    .section-lede.on-dark { color: var(--color-dark-text-soft); }
    .note {
      margin-top: 22px;
      padding-top: 24px;
      border-top: 1px solid var(--color-border);
      font-size: 12.5px;
      line-height: 1.9;
      color: var(--color-muted);
      max-width: 96ch;
    }
    .note.on-dark { border-top-color: var(--color-dark-border); color: var(--color-dark-muted); }
    .note strong { color: var(--color-text-soft); }
    .note.on-dark strong { color: var(--color-dark-text-soft); }
    details.note-details { margin-top: 22px; }
    details.note-details.on-dark { padding-top: 22px; border-top: 1px solid var(--color-dark-border); margin-top: 18px; }
    details.note-details summary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      color: var(--color-muted);
      cursor: pointer;
    }
    details.note-details.on-dark summary { font-size: 13px; font-weight: 700; color: var(--color-dark-text-soft); }
    details.note-details summary:hover { color: var(--color-text); }
    details.note-details.on-dark summary:hover { color: var(--color-dark-text); }
    details.note-details .note-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 26px;
      margin-top: 22px;
    }
    details.note-details .note-grid p { margin: 0; font-size: 12.5px; line-height: 1.9; color: var(--color-dark-muted); }
    details.note-details .note-grid p strong { color: var(--color-dark-text-soft); }
    details.note-details > p { margin: 12px 0 0; max-width: 88ch; font-size: 12.5px; line-height: 1.9; color: var(--color-muted); }

    /* PROBLEM（3カード） */
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(268px, 1fr));
      gap: 20px;
      margin-top: 56px;
    }
    .problem-card {
      padding: 34px;
      background: #fff;
      border: 1px solid var(--color-border2);
      border-radius: 22px;
    }
    .problem-card__label {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--color-accent2);
    }
    .problem-card h3 {
      margin: 16px 0 0;
      font-size: 23px;
      font-weight: 700;
      line-height: 1.5;
    }
    .problem-card p {
      margin: 14px 0 0;
      font-size: 14.5px;
      line-height: 1.9;
      color: var(--color-text-soft);
    }

    /* LIVE DEMO（ダーク・チャットUIカード2枚 + 自動再生アニメーション） */
    .demo-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
    .demo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
      gap: 24px;
      margin-top: 44px;
    }
    .demo-card {
      border: 1px solid var(--color-dark-border);
      border-radius: 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .demo-card.is-ours { background: var(--color-dark-navy); }
    .demo-card.is-cloud { background: var(--color-dark-surface); }
    .demo-card__head {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 16px 22px;
      border-bottom: 1px solid var(--color-dark-border2);
      background: var(--color-dark-card);
    }
    .demo-card.is-cloud .demo-card__head {
      border-bottom-color: var(--color-dark-border);
      background: var(--color-dark-slate);
    }
    .demo-card__dot { width: 8px; height: 8px; border-radius: 999px; }
    .demo-card.is-ours .demo-card__dot { background: var(--color-green); }
    .demo-card.is-cloud .demo-card__dot { background: var(--color-orange); }
    .demo-card__title { font-size: 13px; font-weight: 700; color: var(--color-dark-text); }
    .demo-card__badge {
      padding: 3px 9px;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 9.5px;
      letter-spacing: 0.06em;
    }
    .demo-card.is-ours .demo-card__badge { border: 1px solid var(--color-green); color: var(--color-green); }
